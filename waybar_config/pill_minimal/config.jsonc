{
  "layer": "top",
  "position": "top",
  // height omitted -> waybar sizes the bar to its (font-relative) content, so it tracks the waybar font size
  "exclusive": true,
  // LEFT
  "modules-left": [
    /* POWER:BEGIN */
    "custom/power",
    /* POWER:END */
    /* LAUNCHER:BEGIN */
    "custom/launcher",
    /* LAUNCHER:END */
    "hyprland/workspaces"
  ],
  // CENTER
  "modules-center": [
    "custom/workspace-prev",
    "clock",
    "custom/workspace-next"
  ],
  // RIGHT
  "modules-right": [
    "custom/browser",
    "tray",
    /* VPN:BEGIN */
    "custom/vpn",
    /* VPN:END */
    "custom/audio"
    /* BATTERY:BEGIN */
    , "battery"
    /* BATTERY:END */
  ],
  // ===== Modules =====
  /* POWER:BEGIN */
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Power",
    "on-click": "dotctl power"
  },
  /* POWER:END */
  /* LAUNCHER:BEGIN */
  "custom/launcher": {
    // "format": "\ue7e6",  // Gentoo
    // "format": "\uf303",  // Arch Linux
    // "format": "\uf306",  // Debian
    // "format": "\uf32e",  // Void Linux
    "format": "\uf17c",    // Tux (replaced at apply time by dotctl)
    "tooltip-format": "Launcher",
    "on-click": "dotctl launcher"
  },
  /* LAUNCHER:END */
  "custom/browser": {
    "format": "Browser",
    "tooltip-format": "Web Browser",
    "on-click": "xdg-open https://",
    "return-type": "static"
  },
  "custom/workspace-prev": {
    "format": "\uf053",
    "tooltip": true,
    "tooltip-format": "Previous workspace",
    "on-click": "dotctl ws-cycle prev 1 10"
  },
  "custom/workspace-next": {
    "format": "\uf054",
    "tooltip": true,
    "tooltip-format": "Next workspace",
    "on-click": "dotctl ws-cycle next 1 10"
  },
  /* VPN:BEGIN */
  "custom/vpn": {
    "exec": "vpn-status-indicator",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "on-click": "vpnctl menu"
  },
  /* VPN:END */
  "clock": {
    "format": "[{:%a %I:%M:%S}]",
    "format-alt": "[{:%A, %B %d, %Y}]",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt>{calendar}</tt>",
    "interval": 1,
    "on-click": "gsimplecal",
    "on-click-right": "notify-send 'Timezones' \"Local: $(date)\\nUTC: $(TZ=UTC date)\""
  },
  "tray": {
    "icon-size": 20,
    "spacing": 6,
    "reverse-direction": false
  },
  "custom/audio": {
    "format": "{}",
    "return-type": "json",
    "exec": "dotctl audio-output-status",
    "on-click": "dotctl audio-output-menu",
    "on-click-right": "pavucontrol",
    "on-scroll-up":   "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  /* BATTERY:BEGIN */
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% \uf0e7",
    "format-plugged": "{capacity}% \uf1e6",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{capacity}% · {timeTo}"
  },
  /* BATTERY:END */
  "hyprland/workspaces": {
    "disable-scroll": false,
    "on-click": "activate"
  }
}
