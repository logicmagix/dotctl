{
  "layer": "top",
  "position": "top",
  // height omitted -> waybar sizes the bar to its (font-relative) content, so it tracks the waybar font size
  "exclusive": true,
  // LEFT
  "modules-left": [
    "custom/power",
    "custom/rarrow1",
    "custom/launcher",
    "custom/rarrow2",
    "hyprland/workspaces",
    "custom/rarrow3"
  ],
  // CENTER
  "modules-center": [
    "custom/rarrow-center-l",
    "clock",
    "custom/rarrow-center-r"
  ],
  // RIGHT
  "modules-right": [
    "custom/rsep-browser", "custom/browser",
    "custom/rsep-tray",    "tray",
    /* VPN:BEGIN */
    "custom/rsep-vpn",     "custom/vpn",
    /* VPN:END */
    "custom/rsep-pulse",   "custom/audio"
    /* BATTERY:BEGIN */
    , "custom/rsep-battery", "battery"
    /* BATTERY:END */
  ],
  // ===== Separators (pointed chevrons - swapped to half-circles when WAYBAR_DECOR=round) =====
  "custom/rarrow1":         { "format": "\ue0b0", "tooltip": false },
  "custom/rarrow2":         { "format": "\ue0b0", "tooltip": false },
  "custom/rarrow3":         { "format": "\ue0b0", "tooltip": false },
  "custom/rarrow-center-l": {
    "format": "\ue0b2",
    "tooltip": true,
    "tooltip-format": "Previous workspace",
    "on-click": "ws-cycle prev 1 10"
  },
  "custom/rarrow-center-r": {
    "format": "\ue0b0",
    "tooltip": true,
    "tooltip-format": "Next workspace",
    "on-click": "ws-cycle next 1 10"
  },
  "custom/rsep-browser":    { "format": "\ue0b2", "tooltip": false },
  "custom/rsep-tray":       { "format": "\ue0b2", "tooltip": false },
  /* VPN:BEGIN */
  "custom/rsep-vpn": {
    "exec": "vpn-status-indicator",
    "interval": 5,
    "return-type": "json",
    "format": "\ue0b2",
    "tooltip": false
  },
  /* VPN:END */
  "custom/rsep-pulse":      { "format": "\ue0b2", "tooltip": false },
  /* VPN:BEGIN */
  "custom/rsep-pulse": {
    "exec": "vpn-status-indicator",
    "interval": 5,
    "return-type": "json",
    "format": "\ue0b2",
    "tooltip": false
  },
  /* VPN:END */
  /* BATTERY:BEGIN */
  "custom/rsep-battery":    { "format": "\ue0b2", "tooltip": false },
  /* BATTERY:END */
  // ===== Modules =====
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Power",
    "on-click": "power"
  },
  "custom/launcher": {
    // "format": "\ue7e6",  // Gentoo
    // "format": "\uf303",  // Arch Linux
    // "format": "\uf306",  // Debian
    // "format": "\uf32e",  // Void Linux
    "format": "\uf17c",    // Tux (replaced at apply time by dotctl)
    "tooltip-format": "Launcher",
    "on-click": "dotctl launcher"
  },
  "custom/browser": {
    "format": " Browser ",
    "tooltip-format": "Web Browser",
    "on-click": "xdg-open https://",
    "return-type": "static"
  },
  /* VPN:BEGIN */
  "custom/vpn": {
    "exec": "vpn-status-indicator",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "on-click": "vpnctl menu"
  },
  /* VPN:END */
  "clock": {
    "format": "[{:%a %I:%M:%S}]",
    "format-alt": "[{:%A, %B %d, %Y}]",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt>{calendar}</tt>",
    "interval": 1,
    "on-click": "gsimplecal",
    "on-click-right": "notify-send 'Timezones' \"Local: $(date)\\nUTC: $(TZ=UTC date)\""
  },
  "tray": {
    "icon-size": 20,
    "spacing": 6,
    "reverse-direction": false
  },
  "custom/audio": {
    "format": "{}",
    "return-type": "json",
    "exec": "audio-output-status",
    "on-click": "audio-output-menu",
    "on-click-right": "pavucontrol",
    "on-scroll-up":   "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  /* BATTERY:BEGIN */
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% \uf0e7",
    "format-plugged": "{capacity}% \uf1e6",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{capacity}% · {timeTo}"
  },
  /* BATTERY:END */
  "hyprland/workspaces": {
    "disable-scroll": false,
    "on-click": "activate"
  }
}
