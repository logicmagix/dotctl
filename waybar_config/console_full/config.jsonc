{
  "layer": "top",
  "position": "top",
  // height omitted -> waybar sizes the bar to its (font-relative) content, so it tracks the waybar font size
  "exclusive": true,
  // LEFT
  "modules-left": [
    /* POWER:BEGIN */
    "custom/power",
    "custom/rarrow1",
    /* POWER:END */
    /* LAUNCHER:BEGIN */
    "custom/launcher",
    "custom/rarrow2",
    /* LAUNCHER:END */
    "hyprland/workspaces",
    "custom/rarrow3"
    /* CPU:BEGIN */
    , "cpu",
    "custom/rarrow4"
    /* CPU:END */
    /* CPUTEMP:BEGIN */
    , "custom/cputemp",
    "custom/rarrow5"
    /* CPUTEMP:END */
    /* RAM:BEGIN */
    , "memory",
    "custom/rarrow6"
    /* RAM:END */
    /* GPU:BEGIN */
    , "custom/gpu",
    "custom/rarrow7"
    /* GPU:END */
    /* VRAM:BEGIN */
    , "custom/vram",
    "custom/rarrow8"
    /* VRAM:END */
  ],
  // CENTER
  "modules-center": [
    "custom/rarrow-center-l",
    "clock",
    "custom/rarrow-center-r"
  ],
  // RIGHT
  "modules-right": [
    "custom/rsep-terminal", "custom/terminal",
    "custom/rsep-files",    "custom/files",
    "custom/rsep-editor",   "custom/editor",
    "custom/rsep-browser",  "custom/browser",
    "custom/rsep-tray",     "tray"
    /* VPN:BEGIN */
    , "custom/rsep-vpn",    "custom/vpn"
    /* VPN:END */
    /* AUDIO:BEGIN */
    , "custom/rsep-pulse",  "custom/audio"
    /* AUDIO:END */
    /* BATTERY:BEGIN */
    , "custom/rsep-battery", "battery"
    /* BATTERY:END */
  ],
  // ===== Separators (pointed chevrons - swapped to half-circles when WAYBAR_DECOR=round) =====
  "custom/rarrow1":        { "format": "\ue0b0", "tooltip": false },
  "custom/rarrow2":        { "format": "\ue0b0", "tooltip": false },
  // Chevrons flanking a thermal block exec `dotctl thermal-sep`, which
  // republishes the neighbor states as prefixed classes (out-* = block the
  // glyph leads out of, in-* = block it leads into) so style.css can repaint
  // glyph and bg to match - GTK CSS has no previous-sibling selector and
  // waybar/GTK ignores `~`. Duplicate keys resolve last-wins (same trick as
  // rsep-pulse), ordered furthest-module-first like the rules in style.css.
  "custom/rarrow3":        { "format": "\ue0b0", "tooltip": false },
  /* GPU:BEGIN */
  "custom/rarrow3":        { "exec": "dotctl thermal-sep --in gputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* GPU:END */
  /* RAM:BEGIN */
  "custom/rarrow3":        { "format": "\ue0b0", "tooltip": false },
  /* RAM:END */
  /* CPUTEMP:BEGIN */
  "custom/rarrow3":        { "exec": "dotctl thermal-sep --in cputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* CPUTEMP:END */
  /* CPU:BEGIN */
  "custom/rarrow3":        { "format": "\ue0b0", "tooltip": false },
  /* CPU:END */
  "custom/rarrow4":        { "format": "\ue0b0", "tooltip": false },
  /* GPU:BEGIN */
  "custom/rarrow4":        { "exec": "dotctl thermal-sep --in gputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* GPU:END */
  /* RAM:BEGIN */
  "custom/rarrow4":        { "format": "\ue0b0", "tooltip": false },
  /* RAM:END */
  /* CPUTEMP:BEGIN */
  "custom/rarrow4":        { "exec": "dotctl thermal-sep --in cputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* CPUTEMP:END */
  /* CPUTEMP:BEGIN */
  "custom/rarrow5":        { "exec": "dotctl thermal-sep --out cputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* GPU:BEGIN */
  "custom/rarrow5":        { "exec": "dotctl thermal-sep --out cputemp --in gputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* GPU:END */
  /* RAM:BEGIN */
  "custom/rarrow5":        { "exec": "dotctl thermal-sep --out cputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* RAM:END */
  /* CPUTEMP:END */
  "custom/rarrow6":        { "format": "\ue0b0", "tooltip": false },
  /* GPU:BEGIN */
  "custom/rarrow6":        { "exec": "dotctl thermal-sep --in gputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  "custom/rarrow7":        { "exec": "dotctl thermal-sep --out gputemp", "interval": "once", "signal": 8, "return-type": "json", "format": "\ue0b0", "tooltip": false },
  /* GPU:END */
  "custom/rarrow8":        { "format": "\ue0b0", "tooltip": false },
  "custom/rarrow-center-l": {
    "format": "\ue0b2",
    "tooltip": true,
    "tooltip-format": "Previous workspace",
    "on-click": "dotctl ws-cycle prev 1 10"
  },
  "custom/rarrow-center-r": {
    "format": "\ue0b0",
    "tooltip": true,
    "tooltip-format": "Next workspace",
    "on-click": "dotctl ws-cycle next 1 10"
  },
  "custom/rsep-terminal":  { "format": "\ue0b2", "tooltip": false },
  "custom/rsep-files":     { "format": "\ue0b2", "tooltip": false },
  "custom/rsep-editor":    { "format": "\ue0b2", "tooltip": false },
  "custom/rsep-browser":   { "format": "\ue0b2", "tooltip": false },
  "custom/rsep-tray":      { "format": "\ue0b2", "tooltip": false },
  /* VPN:BEGIN */
  // VPN separators re-exec only on RTMIN+9, sent by vpn-status-indicator
  // the moment the state class flips (and by vpnctl after connect /
  // disconnect / killswitch changes) - independent poll timers left them
  // trailing the vpn block by up to an interval.
  "custom/rsep-vpn": {
    "exec": "vpn-status-indicator",
    "interval": "once",
    "signal": 9,
    "return-type": "json",
    "format": "\ue0b2",
    "tooltip": false
  },
  /* VPN:END */
  /* AUDIO:BEGIN */
  "custom/rsep-pulse":     { "format": "\ue0b2", "tooltip": false },
  /* VPN:BEGIN */
  "custom/rsep-pulse": {
    "exec": "vpn-status-indicator",
    "interval": "once",
    "signal": 9,
    "return-type": "json",
    "format": "\ue0b2",
    "tooltip": false
  },
  /* VPN:END */
  /* AUDIO:END */
  /* BATTERY:BEGIN */
  "custom/rsep-battery":  { "format": "\ue0b2", "tooltip": false },
  /* BATTERY:END */
  // ===== Modules =====
  /* POWER:BEGIN */
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Power",
    "on-click": "dotctl power"
  },
  /* POWER:END */
  /* LAUNCHER:BEGIN */
  "custom/launcher": {
    // "format": "\ue7e6",  // Gentoo
    // "format": "\uf303",  // Arch Linux
    // "format": "\uf306",  // Debian
    // "format": "\uf32e",  // Void Linux
    "format": "\uf17c",    // Tux (replaced at apply time by dotctl)
    "tooltip-format": "Launcher",
    "on-click": "dotctl launcher"
  },
  /* LAUNCHER:END */
  "custom/terminal": {
    "format": " Terminal ",
    "tooltip-format": "Terminal",
    "on-click": "for t in kitty foot alacritty wezterm ghostty gnome-terminal konsole xterm; do command -v $t >/dev/null 2>&1 && exec $t; done",
    "return-type": "static"
  },
  "custom/files": {
    "format": " Files ",
    "tooltip-format": "File Browser",
    "on-click": "for f in nemo nautilus dolphin thunar pcmanfm caja; do command -v $f >/dev/null 2>&1 && exec $f \"$HOME\"; done; exec xdg-open \"$HOME\"",
    "return-type": "static"
  },
  "custom/editor": {
    "format": " Editor ",
    "tooltip-format": "Editor",
    "on-click": "T=$(command -v kitty 2>/dev/null || command -v foot 2>/dev/null || command -v alacritty 2>/dev/null || command -v wezterm 2>/dev/null || command -v xterm 2>/dev/null); E=$(command -v nvim 2>/dev/null || command -v vim 2>/dev/null || command -v vi 2>/dev/null); test -n \"$T\" -a -n \"$E\" && exec $T -e $E",
    "return-type": "static"
  },
  "custom/browser": {
    "format": " Browser ",
    "tooltip-format": "Web Browser",
    "on-click": "xdg-open https://",
    "return-type": "static"
  },
  /* VPN:BEGIN */
  "custom/vpn": {
    "exec": "vpn-status-indicator",
    "interval": 5,
    "signal": 9,
    "return-type": "json",
    "format": "{}",
    "on-click": "vpnctl menu"
  },
  /* VPN:END */
  // ===== System modules =====
  /* CPU:BEGIN */
  "cpu": {
    "format": "Load: {usage}%",
    "tooltip": true
  },
  /* CPU:END */
  /* CPUTEMP:BEGIN */
  "custom/cputemp": {
    "exec": "dotctl cputemp",
    "return-type": "json",
    "format": "{}",
    "interval": 3,
    "tooltip": true
  },
  /* CPUTEMP:END */
  /* RAM:BEGIN */
  "memory": {
    "format": "RAM: {used:0.1f}G/{total:0.1f}G",
    "tooltip": true
  },
  /* RAM:END */
  /* GPU:BEGIN */
  "custom/gpu": {
    "exec": "dotctl gputemp",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "tooltip": true
  },
  /* GPU:END */
  /* VRAM:BEGIN */
  "custom/vram": {
    "exec": "dotctl vram",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "tooltip": true
  },
  /* VRAM:END */
  "clock": {
    "format": "[{:%a %I:%M:%S}]",
    "format-alt": "[{:%A, %B %d, %Y}]",
    "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt>{calendar}</tt>",
    "interval": 1,
    "on-click": "gsimplecal",
    "on-click-right": "notify-send 'Timezones' \"Local: $(date)\\nUTC: $(TZ=UTC date)\""
  },
  "tray": {
    "icon-size": 20,
    "spacing": 6,
    "reverse-direction": false
  },
  /* AUDIO:BEGIN */
  "custom/audio": {
    "format": "{}",
    "return-type": "json",
    "exec": "dotctl audio-output-status",
    "on-click": "dotctl audio-output-menu",
    "on-click-right": "pavucontrol",
    "on-scroll-up":   "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  /* AUDIO:END */
  /* BATTERY:BEGIN */
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% \uf0e7",
    "format-plugged": "{capacity}% \uf1e6",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{capacity}% · {timeTo}"
  },
  /* BATTERY:END */
  "hyprland/workspaces": {
    "disable-scroll": false,
    "on-click": "activate"
  }
}
