#!/bin/bash
# keybinds - hyprland keybinds cheatsheet (wofi)
#
# Two sources, picked automatically:
#
#   live  (Hyprland >= 0.57, Lua config) - reads `hyprctl binds -j`, the
#         compositor's own view of what is bound. Section headers are
#         recovered from the `-- Header` comments in the Lua modules that
#         hyprland.lua require()s, so grouping survives.
#   conf  (Hyprland < 0.57, hyprlang config) - the original behaviour: parse
#         ~/.config/hypr/hyprland.conf, follow `source = ...` recursively,
#         and surface bind lines carrying a trailing `# Label` annotation.
#
# Override with KEYBINDS_SOURCE=live|conf. See `keybinds --help`.

set -euo pipefail
shopt -s extglob

# Toggle off if wofi is already up
if pgrep -x wofi >/dev/null; then
  pkill -x wofi
  exit 0
fi

# ──────────────────────────────────────────────────────────────────────────────
#  Config
# ──────────────────────────────────────────────────────────────────────────────

readonly HYPR_CONF="${HYPR_CONF:-$HOME/.config/hypr/hyprland.conf}"
readonly HYPR_LUA="${HYPR_LUA:-$HOME/.config/hypr/hyprland.lua}"
readonly DEFAULT_HEADER_COLOR='#83a598'
HEADER_COLOR="${KEYBINDS_HEADER_COLOR:-$DEFAULT_HEADER_COLOR}"
PRINT_ONLY=false

die()  { printf 'keybinds: %s\n' "$*" >&2; exit 1; }
warn() { printf 'keybinds: %s\n' "$*" >&2; }

case "${1:-}" in
  -h|--help|help)
    cat <<'EOF'
keybinds - hyprland keybinds cheatsheet (wofi)

USAGE
  keybinds            Toggle the cheatsheet (open if closed, close if open)
  keybinds --print    Dump the cheatsheet to stdout instead of wofi
  keybinds --source   Print which source would be used, then exit
  keybinds -h         This help

SOURCES
  On Hyprland >= 0.57 the config is Lua and `hyprland.conf` is ignored by the
  compositor, so the cheatsheet reads live state from `hyprctl binds -j`.
  Every bind that carries a `description` is shown - that is the Lua
  equivalent of the old trailing `# Label` opt-in:

    hl.bind("SUPER + T", hl.dsp.exec_cmd("kitty"), { description = "Terminal" })

  Section headers are read from the `-- Header` comment lines in the Lua
  modules required by hyprland.lua, matched to binds by description.

  On Hyprland < 0.57 the original hyprlang parser is used instead.

ANNOTATION GRAMMAR (hyprlang / `conf` source only)
  Add a trailing `# Label` to any bind line you want to appear:

    # Browser binds                            ← section header
    bind = $mainMod, B, exec, $browser  # Brave             ← row label

  Bindings without a trailing `# Label` are silently skipped, so the
  cheatsheet only ever shows what you explicitly opted in.

  Section headers come from the FIRST stand-alone `# ...` comment line
  of each comment block preceding a group of binds. Blank lines reset the
  block. All `bind*` variants are recognised. Sourced .conf files are
  followed automatically via `source = ...`.

ENV
  KEYBINDS_SOURCE        Force the source: `live` or `conf`
                         (default: auto-detect from the Hyprland version)
  HYPR_CONF              Path to hyprland.conf (hyprlang source)
                         (default: ~/.config/hypr/hyprland.conf)
  HYPR_LUA               Path to hyprland.lua (for section headers)
                         (default: ~/.config/hypr/hyprland.lua)
  KEYBINDS_HEADER_COLOR  Pango color for section headers
                         (default: #83a598)
EOF
    exit 0;;
  --print) PRINT_ONLY=true;;
  --source) ;;
  '') ;;
  *) die "unknown argument: $1 (try \`keybinds --help\`)";;
esac

# ──────────────────────────────────────────────────────────────────────────────
#  Source selection
# ──────────────────────────────────────────────────────────────────────────────

# Hyprland >= 0.57 is Lua-configured and ignores hyprland.conf.
_hypr_is_lua() {
  local v
  v=$(hyprctl version -j 2>/dev/null \
      | sed -n 's/.*"tag" *: *"v\{0,1\}\([0-9.]*\)".*/\1/p' | cut -d. -f1,2)
  [[ -z "$v" ]] && return 1
  [[ "$(printf '%s\n0.57\n' "$v" | sort -V | head -1)" == "0.57" ]]
}

SOURCE="${KEYBINDS_SOURCE:-}"
if [[ -z "$SOURCE" ]]; then
  if _hypr_is_lua; then SOURCE=live; else SOURCE=conf; fi
fi
case "$SOURCE" in
  live|conf) ;;
  *) die "invalid KEYBINDS_SOURCE: $SOURCE (expected live or conf)";;
esac

if [[ "${1:-}" == "--source" ]]; then
  printf '%s\n' "$SOURCE"
  exit 0
fi

command -v wofi >/dev/null 2>&1 || [[ "$PRINT_ONLY" == "true" ]] || die "wofi not found in PATH"

# ──────────────────────────────────────────────────────────────────────────────
#  Parser state
# ──────────────────────────────────────────────────────────────────────────────

declare -a SECTIONS=()
declare -A SECTION_ROWS=()
declare -A SEEN_FILES=()
SECTION_CANDIDATE=""
PREV_WAS_COMMENT=false
MAIN_MOD="SUPER"

# ──────────────────────────────────────────────────────────────────────────────
#  Helpers (REPLY-style: set REPLY/COMBO instead of stdout, so the hot parse
#  loop never forks a subshell. Cuts wall time on a 600-line conf from ~1.1s
#  to <100ms by avoiding ~500 fork/exec round-trips.)
# ──────────────────────────────────────────────────────────────────────────────

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  REPLY="$s"
}

resolve_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  p="${p//\$HOME/$HOME}"
  REPLY="$p"
}

# Strip leading/trailing #, -, space from a comment line so headers like
# "### MONITORS ###" or "# --- Audio output switching ---" become "MONITORS"
# and "Audio output switching" respectively.
clean_section() {
  local s="$1"
  s="${s##+([[:space:]#\-])}"
  s="${s%%+([[:space:]#\-])}"
  REPLY="$s"
}

fmt_mod() {
  case "$1" in
    '$mainMod')                                REPLY="$MAIN_MOD" ;;
    Control_L|Control_R|CONTROL|Control|Ctrl)  REPLY='CTRL' ;;
    CTRL_ALT)                                  REPLY='CTRL + ALT' ;;
    ALT_SHIFT)                                 REPLY='ALT + SHIFT' ;;
    SHIFT_ALT)                                 REPLY='SHIFT + ALT' ;;
    *_*)                                       REPLY="${1//_/ + }" ;;
    *)                                         REPLY="$1" ;;
  esac
}

fmt_key() {
  case "$1" in
    left|Left)             REPLY='←' ;;
    right|Right)           REPLY='→' ;;
    up|Up)                 REPLY='↑' ;;
    down|Down)             REPLY='↓' ;;
    mouse_down)            REPLY='wheel ↓' ;;
    mouse_up)              REPLY='wheel ↑' ;;
    mouse:272)             REPLY='LMB' ;;
    mouse:273)             REPLY='RMB' ;;
    equal)                 REPLY='=' ;;
    minus)                 REPLY='−' ;;
    XF86AudioRaiseVolume)  REPLY='Volume +' ;;
    XF86AudioLowerVolume)  REPLY='Volume −' ;;
    XF86AudioMute)         REPLY='Mute' ;;
    XF86AudioMicMute)      REPLY='Mic Mute' ;;
    XF86AudioPlay)         REPLY='Play' ;;
    XF86AudioPause)        REPLY='Pause' ;;
    XF86AudioNext)         REPLY='Next' ;;
    XF86AudioPrev)         REPLY='Prev' ;;
    XF86MonBrightnessUp)   REPLY='Brightness +' ;;
    XF86MonBrightnessDown) REPLY='Brightness −' ;;
    *)                     REPLY="$1" ;;
  esac
}

# Sets COMBO. Avoids the per-token subshell that `out+="$(fmt_mod ...) +"`
# would incur (each call to fmt_mod is otherwise a fork).
format_combo() {
  local mods_raw="$1" key="$2" tok
  COMBO=""
  for tok in $mods_raw; do
    [[ -n "$tok" ]] || continue
    fmt_mod "$tok"
    COMBO+="$REPLY + "
  done
  fmt_key "$key"
  COMBO+="$REPLY"
}

# Decode a wayland/xkb modifier bitmask into "SUPER + CTRL + ..." order.
# SHIFT=1 CAPS=2 CTRL=4 ALT=8 MOD2=16 MOD3=32 LOGO=64 MOD5=128
fmt_modmask() {
  local m="$1" out=""
  (( m & 64 ))  && out+="SUPER + "
  (( m & 4 ))   && out+="CTRL + "
  (( m & 8 ))   && out+="ALT + "
  (( m & 1 ))   && out+="SHIFT + "
  (( m & 2 ))   && out+="CAPS + "
  (( m & 16 ))  && out+="MOD2 + "
  (( m & 32 ))  && out+="MOD3 + "
  (( m & 128 )) && out+="MOD5 + "
  REPLY="$out"
}

add_row() {
  local sect="$1" label="$2" combo="$3"
  sect="${sect% binds}"
  sect="${sect% bind}"
  [[ -z "$sect" ]] && sect="Other"
  if [[ -z "${SECTION_ROWS[$sect]:-}" ]]; then
    SECTIONS+=("$sect")
    SECTION_ROWS[$sect]=""
  fi
  SECTION_ROWS[$sect]+="$label"$'\t'"$combo"$'\n'
}

# ──────────────────────────────────────────────────────────────────────────────
#  live source: hyprctl binds -j + section headers from the Lua modules
# ──────────────────────────────────────────────────────────────────────────────

# Emit "section<TAB>description" for every bind-ish line in the Lua config,
# in file order. The description is the LAST double-quoted string on the line,
# which holds for every form used in practice:
#   exec(M, "T", terminal, "Terminal (Kitty)")
#   hl.bind(key(M, "Q"), hl.dsp.window.close(), { description = "Kill" })
#   hl.bind("XF86AudioMute", hl.dsp.exec_cmd("..."), el("Toggle mute"))
# A trailing `"Workspace " .. i` yields the prefix, matched by prefix below.
lua_section_map() {
  local entry file dir
  [[ -f "$HYPR_LUA" ]] || return 0
  dir=$(dirname "$HYPR_LUA")

  # hyprland.lua only require()s modules; walk them in declaration order.
  while IFS= read -r entry; do
    file="$dir/${entry//.//}.lua"
    [[ -f "$file" ]] || continue
    awk '
      # Stand-alone comment line -> section candidate. Skip commented-out code.
      /^[[:space:]]*--/ {
        body = $0
        sub(/^[[:space:]]*--[[:space:]]*/, "", body)
        if (body ~ /^(exec\(|local |hl\.|--)/) next
        if (body !~ /[A-Za-z]/) next
        # Trim to the first sentence / parenthetical so explainer prose does
        # not become the section title.
        if (match(body, /\. /))  body = substr(body, 1, RSTART - 1)
        if (match(body, / \(/))  body = substr(body, 1, RSTART - 1)
        sub(/[[:space:]]+$/, "", body)
        sect = body
        next
      }
      # Bind-ish line -> take the last quoted string as the description.
      /hl\.bind\(|^[[:space:]]*exec\(/ {
        line = $0
        last = ""
        while (match(line, /"[^"]*"/)) {
          last = substr(line, RSTART + 1, RLENGTH - 2)
          line = substr(line, RSTART + RLENGTH)
        }
        if (last != "" && sect != "") print sect "\t" last
      }
    ' "$file"
  done < <(sed -n 's/^[[:space:]]*require("\([^"]*\)").*/\1/p' "$HYPR_LUA")
}

build_live() {
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl not found in PATH"
  command -v jq >/dev/null 2>&1 || die "jq not found in PATH (needed for the live source)"

  local binds
  binds=$(hyprctl binds -j 2>/dev/null) \
    || die "could not read binds from hyprctl (is Hyprland running?)"
  [[ -n "$binds" && "$binds" != "null" ]] || die "hyprctl returned no binds"

  # description<TAB>section, plus a prefix table for dynamic descriptions.
  declare -A DESC_SECT=()
  declare -a PREFIXES=()
  local sect desc
  while IFS=$'\t' read -r sect desc; do
    [[ -z "$desc" ]] && continue
    # First writer wins, so the earliest section owning a description sticks.
    [[ -n "${DESC_SECT[$desc]:-}" ]] || DESC_SECT[$desc]="$sect"
    [[ "$desc" == *' ' ]] && PREFIXES+=("$desc")
  done < <(lua_section_map)

  # Keep hyprctl's order (declaration order), de-duplicating identical rows.
  declare -A SEEN_ROW=()
  local modmask key description combo pfx found row
  while IFS=$'\t' read -r modmask key description; do
    [[ -z "$description" ]] && continue   # no description = opted out
    fmt_modmask "$modmask"; combo="$REPLY"
    fmt_key "$key";         combo+="$REPLY"

    sect="${DESC_SECT[$description]:-}"
    if [[ -z "$sect" ]]; then
      found=""
      for pfx in "${PREFIXES[@]}"; do
        if [[ "$description" == "$pfx"* ]]; then found="${DESC_SECT[$pfx]}"; break; fi
      done
      sect="${found:-Other}"
    fi

    row="$sect"$'\t'"$description"$'\t'"$combo"
    [[ -n "${SEEN_ROW[$row]:-}" ]] && continue
    SEEN_ROW[$row]=1
    add_row "$sect" "$description" "$combo"
  done < <(jq -r '.[] | select(.has_description)
                       | [(.modmask|tostring), .key, .description]
                       | @tsv' <<<"$binds")
}

# ──────────────────────────────────────────────────────────────────────────────
#  conf source: recursive hyprlang parser (Hyprland < 0.57)
# ──────────────────────────────────────────────────────────────────────────────

parse_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  [[ -n "${SEEN_FILES[$file]:-}" ]] && return 0
  SEEN_FILES[$file]=1

  local line trimmed body label rest mods_raw key sect target hdr
  while IFS= read -r line || [[ -n "$line" ]]; do
    trim "$line"; trimmed="$REPLY"

    # Blank line: reset comment-block tracking, but keep section_candidate
    # so the next bind still inherits the previous header.
    if [[ -z "$trimmed" ]]; then
      PREV_WAS_COMMENT=false
      continue
    fi

    # source = directive (recursive include)
    if [[ "$trimmed" =~ ^source[[:space:]]*=[[:space:]]*(.+)$ ]]; then
      target="${BASH_REMATCH[1]}"
      target="${target%%#*}"
      trim "$target";        target="$REPLY"
      resolve_path "$target"; target="$REPLY"
      PREV_WAS_COMMENT=false
      parse_file "$target"
      continue
    fi

    # $mainMod assignment - capture so $mainMod renders as the user's choice
    if [[ "$trimmed" =~ ^\$mainMod[[:space:]]*=[[:space:]]*([A-Za-z][A-Za-z0-9_]*) ]]; then
      MAIN_MOD="${BASH_REMATCH[1]}"
      PREV_WAS_COMMENT=false
      continue
    fi

    # bind line (active OR commented-out). Match before the comment branch
    # so `#bind = ...` is treated as a bind, not a section header.
    if [[ "$trimmed" =~ ^#?bind[a-z]?[[:space:]]*= ]]; then
      # Extract trailing label: greedy match up to the LAST `#` that is
      # preceded by something non-`#`. Bind lines never legitimately
      # contain `#` in their dispatcher args, so this is safe.
      if [[ "$trimmed" =~ ^(#?bind[a-z]?[[:space:]]*=[^#]*)\#[[:space:]]*(.+)$ ]]; then
        body="${BASH_REMATCH[1]}"
        trim "${BASH_REMATCH[2]}"; label="$REPLY"
      else
        PREV_WAS_COMMENT=false
        continue  # no label → opt-out
      fi

      # Strip optional comment-out marker, then `bind* = `
      trim "${body#\#}"; body="$REPLY"
      trim "${body#*=}"; rest="$REPLY"

      # Split first two comma fields: MODS, KEY
      trim "${rest%%,*}"; mods_raw="$REPLY"
      rest="${rest#*,}"
      trim "${rest%%,*}"; key="$REPLY"

      sect="${SECTION_CANDIDATE:-Other}"
      format_combo "$mods_raw" "$key"
      add_row "$sect" "$label" "$COMBO"
      PREV_WAS_COMMENT=false
      continue
    fi

    # Section header: stand-alone comment line. Only the FIRST comment of
    # each block becomes the candidate; subsequent comment lines (descriptive
    # body text) are ignored so they do not override the title.
    if [[ "$trimmed" =~ ^# ]]; then
      if ! $PREV_WAS_COMMENT; then
        clean_section "$trimmed"; hdr="$REPLY"
        if [[ "$hdr" =~ [A-Za-z] ]]; then
          SECTION_CANDIDATE="$hdr"
        fi
      fi
      PREV_WAS_COMMENT=true
      continue
    fi

    # Anything else (config blocks, windowrules, workspace=, etc.)
    PREV_WAS_COMMENT=false
  done < "$file"
}

# ──────────────────────────────────────────────────────────────────────────────
#  Render
# ──────────────────────────────────────────────────────────────────────────────

render() {
  local sect rows label combo width=0 row_width=0 line_width

  for sect in "${SECTIONS[@]}"; do
    while IFS=$'\t' read -r label combo; do
      [[ -z "$label" ]] && continue
      (( ${#label} > width )) && width=${#label}
      line_width=$(( ${#label} + ${#combo} ))
      (( line_width > row_width )) && row_width=$line_width
    done <<< "${SECTION_ROWS[$sect]}"
  done
  (( width > 32 )) && width=32

  # Header rule total width: match the widest row (label + " → " + combo) so
  # the divider sits flush with the row content and never overflows.
  local target=$(( row_width + 5 ))

  local first=true dashes_l dashes_r pad l r
  for sect in "${SECTIONS[@]}"; do
    rows="${SECTION_ROWS[$sect]}"
    [[ -z "$rows" ]] && continue
    $first || printf '\n'
    first=false
    pad=$(( target - ${#sect} - 2 ))
    (( pad < 4 )) && pad=4
    l=$(( pad / 2 )); r=$(( pad - l ))
    printf -v dashes_l '%*s' "$l" ''
    printf -v dashes_r '%*s' "$r" ''
    dashes_l="${dashes_l// /─}"
    dashes_r="${dashes_r// /─}"
    printf '<span foreground="%s"><b>%s %s %s</b></span>\n' \
      "$HEADER_COLOR" "$dashes_l" "$sect" "$dashes_r"
    while IFS=$'\t' read -r label combo; do
      [[ -z "$label" ]] && continue
      printf '󰆍 %-*s → %s\n' "$width" "$label" "$combo"
    done <<< "$rows"
  done
}

# ──────────────────────────────────────────────────────────────────────────────
#  Main
# ──────────────────────────────────────────────────────────────────────────────

if [[ "$SOURCE" == "live" ]]; then
  build_live
  if (( ${#SECTIONS[@]} == 0 )); then
    die "no binds with a description found via hyprctl. Add \`{ description = \"...\" }\` to your hl.bind() calls, or set KEYBINDS_SOURCE=conf."
  fi
else
  [[ -f "$HYPR_CONF" ]] || die "hyprland.conf not found at $HYPR_CONF"
  parse_file "$HYPR_CONF"
  if (( ${#SECTIONS[@]} == 0 )); then
    die "no annotated binds found in $HYPR_CONF (or any sourced files). See \`keybinds --help\` for the annotation grammar."
  fi
fi

if [[ "$PRINT_ONLY" == "true" ]]; then
  render
  exit 0
fi

render | wofi \
  --dmenu \
  --allow-markup \
  --prompt 'Keybindings' \
  --location 7 \
  --width 750 \
  --height 1100 \
  --xoffset 10 \
  --yoffset -35 \
  --insensitive
