#!/bin/bash
# keybinds - hyprland keybinds cheatsheet (wofi)
#
# Reads ~/.config/hypr/hyprland.conf, follows `source = ...` recursively,
# and emits a wofi menu of bind lines that have a trailing `# Label`
# annotation. hyprland.conf itself is never modified - users opt in by
# adding labels to whichever binds they want surfaced.
#
# See `keybinds --help` for the annotation grammar.

set -euo pipefail
shopt -s extglob

# Toggle off if wofi is already up
if pgrep -x wofi >/dev/null; then
  pkill -x wofi
  exit 0
fi

# ──────────────────────────────────────────────────────────────────────────────
#  Config
# ──────────────────────────────────────────────────────────────────────────────

# Detect config format from dotctl state (lua vs legacy)
readonly STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotctl/config"
HYPR_CONFIG="legacy"
if [[ -f "$STATE_FILE" ]]; then
  while IFS='=' read -r key val; do
    [[ "$key" == "HYPR_CONFIG" ]] && { HYPR_CONFIG="${val//\'/}"; break; }
  done < "$STATE_FILE"
fi

# Set default config path based on format
if [[ "$HYPR_CONFIG" == "lua" ]]; then
  readonly HYPR_CONF="${HYPR_CONF:-$HOME/.config/hypr/hyprland.lua}"
else
  readonly HYPR_CONF="${HYPR_CONF:-$HOME/.config/hypr/hyprland.conf}"
fi
readonly DEFAULT_HEADER_COLOR='#83a598'
HEADER_COLOR="${KEYBINDS_HEADER_COLOR:-$DEFAULT_HEADER_COLOR}"
PRINT_ONLY=false

die()  { printf 'keybinds: %s\n' "$*" >&2; exit 1; }
warn() { printf 'keybinds: %s\n' "$*" >&2; }

case "${1:-}" in
  -h|--help|help)
    cat <<'EOF'
keybinds - hyprland keybinds cheatsheet (wofi)

USAGE
  keybinds            Toggle the cheatsheet (open if closed, close if open)
  keybinds --print    Dump the cheatsheet to stdout instead of wofi
  keybinds -h         This help

ANNOTATION GRAMMAR
  Add a trailing comment label to any bind line you want to appear.

  HyprLang (hyprland.conf):
    # Browser binds                            ← section header
    bind = $mainMod, B, exec, $browser  # Brave             ← row label
    bind = $mainMod SHIFT, B, exec, $bp # Brave (Incognito)

  Lua (hyprland.lua, v0.55+):
    -- Browser binds                                        -- section header
    hl.bind("SUPER + B", hl.dsp.exec_cmd("brave"))          -- Brave
    hl.bind("SUPER + SHIFT + B", hl.dsp.exec_cmd("brave --incognito"))  -- Brave (Incognito)

  Bindings without a trailing label are silently skipped, so the
  cheatsheet only ever shows what you explicitly opted in.

  Section headers come from the FIRST stand-alone comment line of each
  comment block preceding a group of binds. Multi-line block comments
  use only the first line, so noisy explainer paragraphs do not pollute
  the section name. Blank lines reset the block.

  For HyprLang: all `bind*` variants are recognised (bind, bindd, bindel,
  bindl, bindm, binde). Commented-out binds (`#bind = ...`) with a
  trailing label are still surfaced - useful for "disabled but documented".

  Sourced files are followed automatically (`source = ...` in HyprLang,
  `dofile(...)` in Lua), so dotctl-keybinds.conf/.lua and any other
  helpers you source are included with no extra wiring.

  The config format is auto-detected from dotctl state (HYPR_CONFIG).

ENV
  HYPR_CONF              Path to hyprland config
                         (default: ~/.config/hypr/hyprland.conf or .lua)
  KEYBINDS_HEADER_COLOR  Pango color for section headers
                         (default: #83a598)
EOF
    exit 0;;
  --print) PRINT_ONLY=true;;
  '') ;;
  *) die "unknown argument: $1 (try \`keybinds --help\`)";;
esac

command -v wofi >/dev/null 2>&1 || [[ "$PRINT_ONLY" == "true" ]] || die "wofi not found in PATH"

# ──────────────────────────────────────────────────────────────────────────────
#  Parser state
# ──────────────────────────────────────────────────────────────────────────────

declare -a SECTIONS=()
declare -A SECTION_ROWS=()
declare -A SEEN_FILES=()
SECTION_CANDIDATE=""
PREV_WAS_COMMENT=false
MAIN_MOD="SUPER"

# ──────────────────────────────────────────────────────────────────────────────
#  Helpers (REPLY-style: set REPLY/COMBO instead of stdout, so the hot parse
#  loop never forks a subshell. Cuts wall time on a 600-line conf from ~1.1s
#  to <100ms by avoiding ~500 fork/exec round-trips.)
# ──────────────────────────────────────────────────────────────────────────────

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  REPLY="$s"
}

resolve_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  p="${p//\$HOME/$HOME}"
  REPLY="$p"
}

# Strip leading/trailing #, -, space from a comment line so headers like
# "### MONITORS ###" or "# --- Audio output switching ---" become "MONITORS"
# and "Audio output switching" respectively. Also handles Lua `--` comments.
clean_section() {
  local s="$1"
  # Strip leading comment markers, dashes, and whitespace
  s="${s##+([[:space:]#\-])}"
  # Strip trailing comment markers, dashes, and whitespace
  s="${s%%+([[:space:]#\-])}"
  REPLY="$s"
}

fmt_mod() {
  case "$1" in
    '$mainMod')                                REPLY="$MAIN_MOD" ;;
    Control_L|Control_R|CONTROL|Control|Ctrl)  REPLY='CTRL' ;;
    CTRL_ALT)                                  REPLY='CTRL + ALT' ;;
    ALT_SHIFT)                                 REPLY='ALT + SHIFT' ;;
    SHIFT_ALT)                                 REPLY='SHIFT + ALT' ;;
    *_*)                                       REPLY="${1//_/ + }" ;;
    *)                                         REPLY="$1" ;;
  esac
}

fmt_key() {
  case "$1" in
    left|Left)             REPLY='←' ;;
    right|Right)           REPLY='→' ;;
    up|Up)                 REPLY='↑' ;;
    down|Down)             REPLY='↓' ;;
    mouse_down)            REPLY='wheel ↓' ;;
    mouse_up)              REPLY='wheel ↑' ;;
    mouse:272)             REPLY='LMB' ;;
    mouse:273)             REPLY='RMB' ;;
    XF86AudioRaiseVolume)  REPLY='Volume +' ;;
    XF86AudioLowerVolume)  REPLY='Volume −' ;;
    XF86AudioMute)         REPLY='Mute' ;;
    XF86AudioMicMute)      REPLY='Mic Mute' ;;
    XF86AudioPlay)         REPLY='Play' ;;
    XF86AudioPause)        REPLY='Pause' ;;
    XF86AudioNext)         REPLY='Next' ;;
    XF86AudioPrev)         REPLY='Prev' ;;
    XF86MonBrightnessUp)   REPLY='Brightness +' ;;
    XF86MonBrightnessDown) REPLY='Brightness −' ;;
    *)                     REPLY="$1" ;;
  esac
}

# Sets COMBO. Avoids the per-token subshell that `out+="$(fmt_mod ...) +"`
# would incur (each call to fmt_mod is otherwise a fork).
format_combo() {
  local mods_raw="$1" key="$2" tok
  COMBO=""
  for tok in $mods_raw; do
    [[ -n "$tok" ]] || continue
    fmt_mod "$tok"
    COMBO+="$REPLY + "
  done
  fmt_key "$key"
  COMBO+="$REPLY"
}

# ──────────────────────────────────────────────────────────────────────────────
#  Recursive parser
# ──────────────────────────────────────────────────────────────────────────────

parse_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  [[ -n "${SEEN_FILES[$file]:-}" ]] && return 0
  SEEN_FILES[$file]=1

  local line trimmed body label rest mods_raw key sect target hdr combo_str

  # Determine comment prefix based on file extension
  local comment_prefix='#'
  [[ "$file" == *.lua ]] && comment_prefix='--'

  while IFS= read -r line || [[ -n "$line" ]]; do
    trim "$line"; trimmed="$REPLY"

    # Blank line: reset comment-block tracking, but keep section_candidate
    # so the next bind still inherits the previous header.
    if [[ -z "$trimmed" ]]; then
      PREV_WAS_COMMENT=false
      continue
    fi

    # source = directive (recursive include) - HyprLang
    if [[ "$trimmed" =~ ^source[[:space:]]*=[[:space:]]*(.+)$ ]]; then
      target="${BASH_REMATCH[1]}"
      target="${target%%#*}"
      trim "$target";        target="$REPLY"
      resolve_path "$target"; target="$REPLY"
      PREV_WAS_COMMENT=false
      parse_file "$target"
      continue
    fi

    # dofile(...) directive (recursive include) - Lua
    # Matches: dofile("path") or dofile(os.getenv("HOME") .. "/.config/hypr/file.lua")
    if [[ "$trimmed" =~ ^dofile\( ]]; then
      # Extract path from various dofile patterns
      if [[ "$trimmed" =~ dofile\(\"([^\"]+)\"\) ]]; then
        # Simple: dofile("/path/to/file.lua")
        target="${BASH_REMATCH[1]}"
      elif [[ "$trimmed" =~ dofile\(os\.getenv\(\"HOME\"\)[[:space:]]*\.\.[[:space:]]*\"([^\"]+)\"\) ]]; then
        # Common: dofile(os.getenv("HOME") .. "/.config/hypr/file.lua")
        target="$HOME${BASH_REMATCH[1]}"
      else
        PREV_WAS_COMMENT=false
        continue
      fi
      resolve_path "$target"; target="$REPLY"
      PREV_WAS_COMMENT=false
      parse_file "$target"
      continue
    fi

    # $mainMod assignment - capture so $mainMod renders as the user's choice (HyprLang)
    if [[ "$trimmed" =~ ^\$mainMod[[:space:]]*=[[:space:]]*([A-Za-z][A-Za-z0-9_]*) ]]; then
      MAIN_MOD="${BASH_REMATCH[1]}"
      PREV_WAS_COMMENT=false
      continue
    fi

    # mainMod assignment - Lua format: local mainMod = "SUPER"
    if [[ "$trimmed" =~ ^local[[:space:]]+mainMod[[:space:]]*=[[:space:]]*\"([A-Za-z][A-Za-z0-9_]*)\" ]]; then
      MAIN_MOD="${BASH_REMATCH[1]}"
      PREV_WAS_COMMENT=false
      continue
    fi

    # Lua hl.bind() syntax - two forms:
    #   1. Literal:  hl.bind("MODS + KEY", ...)  -- Label
    #   2. Concat:   hl.bind(mainMod .. " + KEY", ...)  -- Label
    # The (--)?  makes the leading comment marker optional for active vs commented-out binds
    if [[ "$trimmed" =~ ^(--)?hl\.bind\( ]]; then
      combo_str=""

      # Try literal string first: hl.bind("MODS + KEY", ...)
      if [[ "$trimmed" =~ ^(--)?hl\.bind\(\"([^\"]+)\" ]]; then
        combo_str="${BASH_REMATCH[2]}"
      # Try variable concatenation: hl.bind(var .. " + KEY", ...)
      elif [[ "$trimmed" =~ ^(--)?hl\.bind\(([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\.\.[[:space:]]*\"([^\"]+)\" ]]; then
        local var_name="${BASH_REMATCH[2]}"
        local str_part="${BASH_REMATCH[3]}"
        # Resolve common variable names
        case "$var_name" in
          mainMod) combo_str="$MAIN_MOD$str_part" ;;
          *)       combo_str="$var_name$str_part" ;;  # fallback: use var name literally
        esac
      else
        PREV_WAS_COMMENT=false
        continue  # unrecognized bind format
      fi

      # Check for trailing -- Label comment (after the closing paren)
      # Use \) to anchor after the hl.bind() call, avoiding the leading -- on commented-out binds
      if [[ "$trimmed" =~ \)[[:space:]]*--[[:space:]]*(.+)$ ]]; then
        trim "${BASH_REMATCH[1]}"; label="$REPLY"
        [[ -z "$label" ]] && { PREV_WAS_COMMENT=false; continue; }
      else
        PREV_WAS_COMMENT=false
        continue  # no label → opt-out
      fi

      # Parse combo string: split on " + " to get mods and key
      # The last element is the key, everything before is mods
      local -a parts=()
      local IFS_OLD="$IFS"
      IFS='+' read -ra parts <<< "$combo_str"
      IFS="$IFS_OLD"

      if (( ${#parts[@]} == 0 )); then
        PREV_WAS_COMMENT=false
        continue
      fi

      # Last part is the key
      trim "${parts[-1]}"; key="$REPLY"

      # Everything else is mods
      mods_raw=""
      local i
      for (( i=0; i<${#parts[@]}-1; i++ )); do
        trim "${parts[i]}"
        [[ -n "$REPLY" ]] && mods_raw+="$REPLY "
      done

      sect="${SECTION_CANDIDATE:-Other}"
      sect="${sect% binds}"
      sect="${sect% bind}"

      if [[ -z "${SECTION_ROWS[$sect]:-}" ]]; then
        SECTIONS+=("$sect")
        SECTION_ROWS[$sect]=""
      fi
      format_combo "$mods_raw" "$key"
      SECTION_ROWS[$sect]+="$label"$'\t'"$COMBO"$'\n'
      PREV_WAS_COMMENT=false
      continue
    fi

    # HyprLang bind line (active OR commented-out). Match before the comment branch
    # so `#bind = ...` is treated as a bind, not a section header.
    if [[ "$trimmed" =~ ^#?bind[a-z]?[[:space:]]*= ]]; then
      # Extract trailing label: greedy match up to the LAST `#` that is
      # preceded by something non-`#`. Bind lines never legitimately
      # contain `#` in their dispatcher args, so this is safe.
      if [[ "$trimmed" =~ ^(#?bind[a-z]?[[:space:]]*=[^#]*)\#[[:space:]]*(.+)$ ]]; then
        body="${BASH_REMATCH[1]}"
        trim "${BASH_REMATCH[2]}"; label="$REPLY"
      else
        PREV_WAS_COMMENT=false
        continue  # no label → opt-out
      fi

      # Strip optional comment-out marker, then `bind* = `
      trim "${body#\#}"; body="$REPLY"
      trim "${body#*=}"; rest="$REPLY"

      # Split first two comma fields: MODS, KEY
      trim "${rest%%,*}"; mods_raw="$REPLY"
      rest="${rest#*,}"
      trim "${rest%%,*}"; key="$REPLY"

      sect="${SECTION_CANDIDATE:-Other}"
      sect="${sect% binds}"
      sect="${sect% bind}"

      if [[ -z "${SECTION_ROWS[$sect]:-}" ]]; then
        SECTIONS+=("$sect")
        SECTION_ROWS[$sect]=""
      fi
      format_combo "$mods_raw" "$key"
      SECTION_ROWS[$sect]+="$label"$'\t'"$COMBO"$'\n'
      PREV_WAS_COMMENT=false
      continue
    fi

    # Section header: stand-alone comment line (# for HyprLang, -- for Lua)
    # Only the FIRST comment of each block becomes the candidate; subsequent
    # comment lines (descriptive body text) are ignored so they do not
    # override the title.
    if [[ "$comment_prefix" == "--" && "$trimmed" =~ ^-- ]] || \
       [[ "$comment_prefix" == "#" && "$trimmed" =~ ^# ]]; then
      if ! $PREV_WAS_COMMENT; then
        clean_section "$trimmed"; hdr="$REPLY"
        # For Lua, be stricter: skip if it looks like code or noise
        # - Contains (){}= (code)
        # - Contains :letter (method call like :set_enabled)
        # - Contains :// (URL)
        # - Starts with "local " (variable declaration)
        # - Too long (>50 chars) - real section headers are short
        if [[ "$hdr" =~ [A-Za-z] ]] && \
           (( ${#hdr} <= 50 )) && \
           ! [[ "$hdr" =~ [\(\)\{\}=] ]] && \
           ! [[ "$hdr" =~ :[a-zA-Z] ]] && \
           ! [[ "$hdr" =~ :// ]] && \
           ! [[ "$hdr" =~ ^local\  ]]; then
          SECTION_CANDIDATE="$hdr"
        fi
      fi
      PREV_WAS_COMMENT=true
      continue
    fi

    # Anything else (config blocks, windowrules, workspace=, etc.)
    PREV_WAS_COMMENT=false
  done < "$file"
}

# ──────────────────────────────────────────────────────────────────────────────
#  Render
# ──────────────────────────────────────────────────────────────────────────────

render() {
  local sect rows label combo width=0 row_width=0 line_width

  for sect in "${SECTIONS[@]}"; do
    while IFS=$'\t' read -r label combo; do
      [[ -z "$label" ]] && continue
      (( ${#label} > width )) && width=${#label}
      line_width=$(( ${#label} + ${#combo} ))
      (( line_width > row_width )) && row_width=$line_width
    done <<< "${SECTION_ROWS[$sect]}"
  done
  (( width > 32 )) && width=32

  # Header rule total width: match the widest row (label + " → " + combo) so
  # the divider sits flush with the row content and never overflows.
  local target=$(( row_width + 5 ))

  local first=true dashes_l dashes_r pad l r
  for sect in "${SECTIONS[@]}"; do
    rows="${SECTION_ROWS[$sect]}"
    [[ -z "$rows" ]] && continue
    $first || printf '\n'
    first=false
    pad=$(( target - ${#sect} - 2 ))
    (( pad < 4 )) && pad=4
    l=$(( pad / 2 )); r=$(( pad - l ))
    printf -v dashes_l '%*s' "$l" ''
    printf -v dashes_r '%*s' "$r" ''
    dashes_l="${dashes_l// /─}"
    dashes_r="${dashes_r// /─}"
    # Escape & for Pango markup (XML)
    local sect_escaped="${sect//&/&amp;}"
    printf '<span foreground="%s"><b>%s %s %s</b></span>\n' \
      "$HEADER_COLOR" "$dashes_l" "$sect_escaped" "$dashes_r"
    while IFS=$'\t' read -r label combo; do
      [[ -z "$label" ]] && continue
      printf '󰆍 %-*s → %s\n' "$width" "$label" "$combo"
    done <<< "$rows"
  done
}

# ──────────────────────────────────────────────────────────────────────────────
#  Main
# ──────────────────────────────────────────────────────────────────────────────

[[ -f "$HYPR_CONF" ]] || die "hyprland config not found at $HYPR_CONF"

parse_file "$HYPR_CONF"

if (( ${#SECTIONS[@]} == 0 )); then
  die "no annotated binds found in $HYPR_CONF (or any sourced files). See \`keybinds --help\` for the annotation grammar."
fi

if [[ "$PRINT_ONLY" == "true" ]]; then
  render
  exit 0
fi

render | wofi \
  --dmenu \
  --allow-markup \
  --prompt 'Keybindings' \
  --location 7 \
  --width 750 \
  --height 1100 \
  --xoffset 10 \
  --yoffset -35 \
  --insensitive
