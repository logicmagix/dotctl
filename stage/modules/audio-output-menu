#!/bin/sh

# audio-output lives next to this script, not on PATH (both are dispatched
# through `dotctl <name>`), so call it sibling-relative.
here="$(dirname "$(readlink -f "$0")")"

# Toggle: if any wofi is open, close it
if pgrep -x wofi >/dev/null; then
  pkill -x wofi
  exit 0
fi

choice="$(
  printf '%s\n' \
    '🎧 Headset' \
    '🖥️ Speakers (HDMI)' \
    '🎚️ AUX / Analog' \
    '🔵 Bluetooth' |
  wofi --dmenu \
       --prompt 'Audio output' \
       --location 3 \
       --insensitive \
       --width 420 \
       --height 280 \
       --xoffset -35 \
       --yoffset 15
)"

case "$choice" in
  "🎧 Headset")        "$here/audio-output" headset ;;
  "🖥️ Speakers (HDMI)") "$here/audio-output" speaker ;;
  "🎚️ AUX / Analog")  "$here/audio-output" aux ;;
  "🔵 Bluetooth")      "$here/audio-output" bluetooth ;;
  *) exit 0 ;;
esac

