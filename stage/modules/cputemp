#!/usr/bin/env bash
# waybar-cputemp - print CPU temp + waybar state class (JSON).
# Output: {"text":"CPU: N°C","class":"normal|warning|critical","alt":"...","tooltip":"<cpu model>"}

labels=('Tctl' 'Tdie' 'CPU Package' 'CPU Composite' 'Package id 0')

# The flanking chevrons render this module's state but only re-exec on
# RTMIN+8 ("interval": "once" in the waybar config), so nudge them the
# moment the class flips - polling on separate timers left the block and
# its chevrons flipping up to an interval apart. First run only seeds the
# cache: signaling would re-exec every startup poller for nothing.
notify_state_change() { # <class>
  local f="${XDG_RUNTIME_DIR:-/tmp}/dotctl-cputemp.class" prev=""
  [[ -r "$f" ]] && prev=$(<"$f")
  [[ "$1" == "$prev" ]] && return 0
  printf '%s' "$1" > "$f" 2>/dev/null || return 0
  [[ -n "$prev" ]] && pkill -RTMIN+8 -x waybar 2>/dev/null
  return 0
}

# CPU model name for the tooltip; & escaped for waybar's Pango markup.
cpu_name() {
  local n
  n=$(awk -F': +' '/^model name/ {print $2; exit}' /proc/cpuinfo)
  [[ -n "$n" ]] || n="CPU"
  printf '%s\n' "${n//&/&amp;}"
}

pick_temp() {
  for d in /sys/class/hwmon/hwmon*; do
    for lbl in "${labels[@]}"; do
      f=$(grep -il "^${lbl}$" "$d"/temp*_label 2>/dev/null | head -n1)
      if [[ -n "$f" ]]; then
        inp="${f/_label/_input}"
        if [[ -r "$inp" ]]; then
          cat "$inp"
          return 0
        fi
      fi
    done
  done
  return 1
}

val="$(pick_temp || true)"

# Fallback: any temp*_input; pick the highest.
if [[ -z "$val" ]]; then
  best=0
  for inp in /sys/class/hwmon/hwmon*/temp*_input; do
    [[ -r "$inp" ]] || continue
    v=$(<"$inp")
    [[ -n "$v" ]] || continue
    (( v > best )) && best="$v"
  done
  (( best > 0 )) && val="$best"
fi

name="$(cpu_name)"

if [[ -z "$val" ]]; then
  notify_state_change unknown
  printf '{"text":"CPU: --","class":"unknown","alt":"unknown","tooltip":"%s"}\n' "$name"
  exit 0
fi

t=$((val / 1000))

if   (( t < 60 )); then cls="normal"
elif (( t < 80 )); then cls="warning"
else                    cls="critical"
fi

notify_state_change "$cls"
printf '{"text":"CPU: %d°C","class":"%s","alt":"%s","tooltip":"%s"}\n' "$t" "$cls" "$cls" "$name"
