#!/usr/bin/env bash
# waybar-vram - print GPU VRAM usage + waybar state class (JSON).
# Works with NVIDIA (nvidia-smi) and AMD (amdgpu sysfs mem_info_vram_*).
# Output: {"text":"VRAM: U.UG/T.TG","class":"normal|warning|critical","alt":"...","tooltip":"<used/total MiB (pct)>"}
# On Broadcom VideoCore (v3d - Raspberry Pi 4/5) there is no VRAM to report at
# all, so the block reports GPU busy% instead; see the v3d section below.
# Same never-wake rules as gputemp: nvidia-smi is skipped while the dGPU is
# runtime-suspended or no client holds /dev/nvidiactl, so polling this from
# waybar can't hold the card out of D3.

# True if an NVIDIA GPU is present and runtime-suspended (see gputemp).
nvidia_suspended() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ -r "$d/vendor" && $(<"$d/vendor") == 0x10de ]] || continue
    [[ -r "$d/class"  && $(<"$d/class")  == 0x03*  ]] || continue
    [[ -r "$d/power/runtime_status" && $(<"$d/power/runtime_status") == suspended ]] && return 0
  done
  return 1
}

# Every nvidia-smi call resets the card's runtime-PM autosuspend timer, so
# querying at the waybar interval can pin an idle card awake even when the
# never-wake guards above are satisfied (a client may hold /dev/nvidia* while
# rendering nothing - see gputemp). Cache the reading and refresh at most every
# NVSMI_TTL seconds, so this module is safe at any waybar interval.
NVSMI_TTL=${DOTCTL_NVSMI_TTL:-15}
nvsmi_cache="${XDG_RUNTIME_DIR:-/tmp}/dotctl-vram.cache"

cache_read() {
  local mtime now line
  [[ -r "$nvsmi_cache" ]] || return 1
  mtime=$(stat -c %Y "$nvsmi_cache" 2>/dev/null) || return 1
  now=$(date +%s)
  (( now - mtime < NVSMI_TTL )) || return 1
  line=$(<"$nvsmi_cache") || return 1
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line"
}

# Prints "used_mib total_mib", "sleeping", or nothing.
pick_vram() {
  local used="" total="" cached=""

  if command -v nvidia-smi >/dev/null 2>&1; then
    if nvidia_suspended; then
      printf 'sleeping\n'; return 0
    fi
    # Card awake but unclaimed: querying would reset the autosuspend timer
    # every poll and pin the card awake - report sleeping-bound instead.
    if ! fuser -s /dev/nvidiactl 2>/dev/null; then
      printf 'sleeping\n'; return 0
    fi
    if cached=$(cache_read); then
      printf '%s\n' "$cached"; return 0
    fi
    read -r used total < <(nvidia-smi --query-gpu=memory.used,memory.total \
      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ',')
    if [[ "$used" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]]; then
      # Cache write is best-effort and kept off stdout: the reading must be
      # printed exactly once even when the runtime dir isn't writable.
      { printf '%s %s\n' "$used" "$total" > "$nvsmi_cache"; } 2>/dev/null || true
      printf '%s %s\n' "$used" "$total"
      return 0
    fi
  fi

  # AMD (and any driver exposing the amdgpu-style attributes): bytes -> MiB.
  local d u t
  for d in /sys/class/drm/card*/device; do
    [[ -r "$d/mem_info_vram_used" && -r "$d/mem_info_vram_total" ]] || continue
    u=$(<"$d/mem_info_vram_used"); t=$(<"$d/mem_info_vram_total")
    [[ "$u" =~ ^[0-9]+$ && "$t" =~ ^[0-9]+$ && "$t" -gt 0 ]] || continue
    printf '%s %s\n' $((u / 1048576)) $((t / 1048576))
    return 0
  done

  return 1
}

# --- Broadcom VideoCore / v3d (Raspberry Pi) -------------------------------
# The Pi has no VRAM in any form this module can report: V3D backs its buffers
# with ordinary system RAM through its own MMU, so there is no dedicated pool,
# no mem_info_vram_* attributes, and no total to divide by. (The legacy
# gpu_mem split is gone on Pi 5, and CmaTotal is a 64 MiB carveout v3d does not
# allocate from - reporting it would be a made-up number.) What the driver does
# export is per-queue busy time, so the block reports GPU utilisation instead:
# a real live value with a natural 0-100 range for the same state classes.

# Path to the v3d card's gpu_stats, or nothing.
v3d_stats() {
  local d
  for d in /sys/class/drm/card*/device; do
    [[ -r "$d/gpu_stats" && -r "$d/uevent" ]] || continue
    grep -q '^DRIVER=v3d$' "$d/uevent" || continue
    printf '%s\n' "$d/gpu_stats"
    return 0
  done
  return 1
}

# One sample as "<timestamp_ns> <runtime_ns>..." (one runtime per queue, in
# file order). gpu_stats counters are cumulative, so a rate needs two samples.
v3d_sample() { # <gpu_stats path>
  awk 'NR>1 && NF>=4 { ts=$2; r=r" "$4 } END { if (ts != "") print ts r }' "$1"
}

# Busy percent between two samples: the busiest queue, since bin/render/tfu run
# as concurrent pipeline stages and summing them would exceed 100%. Fails (no
# output) when the samples do not line up or the window is unusable.
v3d_busy() { # <prev sample> <cur sample>
  awk -v p="$1" -v c="$2" 'BEGIN {
    np = split(p, P, " "); nc = split(c, C, " ")
    if (np < 2 || nc != np) exit 1
    dt = C[1] - P[1]
    # Reject a window that is zero-length, backwards, or so old it would
    # average the GPU over minutes of history (stale cache after a restart).
    if (dt <= 0 || dt > 30e9) exit 1
    for (i = 2; i <= nc; i++) {
      d = C[i] - P[i]
      if (d > 0 && d / dt > best) best = d / dt
    }
    b = best * 100
    if (b > 100) b = 100
    printf "%d\n", b + 0.5
  }'
}

# Total GPU memory held by v3d clients, in KiB, from DRM fdinfo. Deduped by
# drm-client-id because inherited/shared fds report the same client from every
# process that holds them. Only same-uid processes are readable, so this is a
# floor, not a total - it stays in the tooltip for that reason.
v3d_mem_kib() {
  local files=()
  # grep first, not awk over the raw glob: awk dies fatally the moment one of
  # those paths is unreadable (another user's process) or has already vanished
  # (an fd closed between glob expansion and the read - a certainty on /proc).
  # grep -s skips both and this also cuts ~800 files down to the handful that
  # are v3d clients.
  mapfile -t files < <(grep -lsE '^drm-driver:[[:space:]]*v3d$' /proc/[0-9]*/fdinfo/* 2>/dev/null)
  (( ${#files[@]} )) || { printf '0\n'; return 0; }
  awk '
    function flush() {
      if (drv == "v3d" && id != "" && !(id in seen)) {
        seen[id] = 1
        sum += (res != "" ? res : tot)
      }
      drv = ""; id = ""; res = ""; tot = ""
    }
    FNR == 1                     { flush() }
    $1 == "drm-driver:"          { drv = $2 }
    $1 == "drm-client-id:"       { id  = $2 }
    $1 == "drm-resident-memory:" { res = $2 }
    $1 == "drm-total-memory:"    { tot = $2 }
    END { flush(); print sum + 0 }
  ' "${files[@]}" 2>/dev/null
}

v3d_report() { # <gpu_stats path>
  local cache="${XDG_RUNTIME_DIR:-/tmp}/dotctl-vram.v3d" cur prev="" pct mem tip
  cur="$(v3d_sample "$1")"
  [[ -n "$cur" ]] || return 1
  [[ -r "$cache" ]] && prev=$(<"$cache")
  pct="$(v3d_busy "$prev" "$cur" || true)"
  # No usable previous sample (first poll after boot, or one left stale by a
  # waybar restart): take our own second sample rather than showing "--" until
  # the next interval comes round.
  if [[ -z "$pct" ]]; then
    prev="$cur"
    sleep 0.25
    cur="$(v3d_sample "$1")"
    pct="$(v3d_busy "$prev" "$cur" || true)"
  fi
  printf '%s' "$cur" > "$cache" 2>/dev/null
  [[ "$pct" =~ ^[0-9]+$ ]] || return 1

  if   (( pct < 75 )); then cls="normal"
  elif (( pct < 90 )); then cls="warning"
  else                      cls="critical"
  fi

  tip="VideoCore (v3d) - no dedicated VRAM, GPU memory comes from system RAM"
  mem="$(v3d_mem_kib)"
  [[ "$mem" =~ ^[0-9]+$ ]] && (( mem > 0 )) && \
    tip="$tip\n$((mem / 1024)) MiB held by v3d clients"

  printf '{"text":"V3D: %d%%","class":"%s","alt":"%s","tooltip":"%s"}\n' \
    "$pct" "$cls" "$cls" "$tip"
}

out="$(pick_vram || true)"

# Only after the discrete-GPU paths come up empty, so a real card always wins.
if [[ -z "$out" ]] && stats="$(v3d_stats)"; then
  v3d_report "$stats" && exit 0
fi

if [[ -z "$out" ]]; then
  printf '{"text":"VRAM: --","class":"unknown","alt":"unknown","tooltip":"no VRAM source"}\n'
  exit 0
fi

if [[ "$out" == "sleeping" ]]; then
  # Same zzz either way, but don't claim "suspended" for a card that is merely
  # unclaimed - on AC it is powered up and staying that way. Matches the
  # wording gputemp uses for the identical condition.
  if nvidia_suspended; then why="GPU suspended"; else why="GPU idle, nothing holding it"; fi
  printf '{"text":"VRAM: zzz","class":"normal","alt":"sleeping","tooltip":"%s"}\n' "$why"
  exit 0
fi

read -r used total <<< "$out"
pct=$(( used * 100 / total ))

if   (( pct < 75 )); then cls="normal"
elif (( pct < 90 )); then cls="warning"
else                      cls="critical"
fi

# MiB -> G with one decimal, matching the RAM module's used/total shape.
text=$(awk -v u="$used" -v t="$total" 'BEGIN{printf "VRAM: %.1fG/%.1fG", u/1024, t/1024}')
printf '{"text":"%s","class":"%s","alt":"%s","tooltip":"%s MiB / %s MiB (%s%%)"}\n' \
  "$text" "$cls" "$cls" "$used" "$total" "$pct"
