#!/usr/bin/env bash
# Check logs with sudo tail -n 40 /var/log/openvpn/nordvpn.log

CONFIG_DIR="/etc/openvpn"
DEFAULT_CONF="${CONFIG_DIR}/nordvpn.conf"
AUTH_FILE="${CONFIG_DIR}/nordvpn.auth"
OVPN_DIR="${HOME}/nordvpn/ovpn_udp"
PIDFILE="/run/openvpn-nordvpn.pid"
# `vpnctl on` backgrounds openvpn, so its output would otherwise die with the
# terminal (the wofi menu closes its kitty window after two seconds).
LOG_FILE="/var/log/openvpn/nordvpn.log"
# Seconds `vpnctl on` waits for tun0 before declaring the connect failed. A
# live server answers the UDP handshake in a few seconds; a retired one never
# does, and openvpn would retry it forever while the indicator shows OFF.
CONNECT_TIMEOUT="${VPNCTL_CONNECT_TIMEOUT:-30}"
# How many random picks to try before giving up on finding a live server.
RANDOM_TRIES=10
# Marker read by vpn-status-indicator (iptables needs root; /run is tmpfs so
# the marker disappears on reboot together with the rules).
KS_MARK="/run/vpnctl-killswitch"

# Use sudo for privileged operations if not already root
if [[ $EUID -ne 0 ]]; then
  SUDO="sudo"
else
  SUDO=""
fi

# Refresh the waybar VPN block + separators right after a state change
# instead of waiting out their poll interval. RTMIN+9 re-execs every
# module wired with "signal": 9 in the waybar config.
nudge_waybar() {
  pkill -RTMIN+9 -x waybar 2>/dev/null
  return 0
}

# Hostname a config connects to: the `remote` line if it is a name, else the
# certificate CN it verifies, else the filename stem (us1234.nordvpn.com).
# NordVPN pins `remote` to an IP and drops the DNS record when it retires a
# server, so "does the CN resolve" is a cheap liveness check for the pool.
cfg_host() {
  local f="$1" host
  host=$(awk '$1=="remote"{print $2; exit}' "$f" 2>/dev/null)
  if [[ -n "$host" && ! "$host" =~ ^[0-9.]+$ && "$host" != *:* ]]; then
    printf '%s\n' "$host"
    return 0
  fi
  host=$(sed -n 's/^verify-x509-name[[:space:]]\{1,\}\(CN=\)\{0,1\}\([^[:space:]]*\).*/\2/p' "$f" 2>/dev/null | head -n1)
  if [[ -z "$host" ]]; then
    host=$(basename "$f")
    host="${host%.ovpn}"; host="${host%.udp}"; host="${host%.tcp}"
  fi
  printf '%s\n' "$host"
}

host_resolves() {
  getent ahosts "$1" >/dev/null 2>&1
}

usage() {
  cat <<USAGE
Usage: vpnctl <command> [args...]

Commands:
  on [file]        Connect using DEFAULT_CONF or OVPN file (relative to \$OVPN_DIR)
  up [file]        Foreground connect (exec; for systemd Type=simple units)
  off              Disconnect (kill OpenVPN)
  status           Show VPN status (process, tun0, public IP)
  list [filter]    List available .ovpn configs (optional grep filter)
  random           Pick random server and connect (skips servers that no longer resolve)
  stale            List configs whose server no longer resolves (retired by provider)
  use <file>       Set DEFAULT_CONF symlink to OVPN file (no connect)
  pick             Interactive pick (requires fzf)
  killswitch on    Enable iptables kill switch (block non-tun0)
  killswitch off   Disable kill switch
  killswitch stat  Show kill switch rule presence
  locs             Show unique "locations" (based on filenames)
USAGE
}

vpn_status() {
  echo "=== VPN STATUS ==="

  if pgrep openvpn >/dev/null 2>&1; then
    echo "OpenVPN: RUNNING NordVPN Configuration"
    echo
    echo "Process:"
    pgrep -fa openvpn | sed 's/^/  /'
  else
    echo "OpenVPN: NOT running. NordVPN Configuration Inactive."
  fi

  echo
  echo "Interface:"
  ip a | grep -A2 'tun0' || echo "  No tun0 interface found"

  echo
  echo "Routing (summary):"
  ip route | sed 's/^/  /' | head -n 10

  echo
  echo "Public IP:"
  if command -v curl >/dev/null 2>&1; then
    printf "  "
    curl -s https://ifconfig.me || echo "  (curl failed)"
    echo
  else
    echo "  curl not installed"
  fi

  echo "==================="
}

vpn_on() {
  local cfgname="${1:-}"

  # If user passed a file, switch default config symlink first
  if [[ -n "$cfgname" ]]; then
    local src="${OVPN_DIR}/${cfgname}"
    if [[ ! -f "$src" ]]; then
      echo "Config not found: $src" >&2
      exit 1
    fi
    $SUDO ln -sf "$src" "$DEFAULT_CONF"
    echo "Default config set to: $cfgname"
  fi

  local host
  host=$(cfg_host "$(readlink -f "$DEFAULT_CONF" 2>/dev/null || echo "$DEFAULT_CONF")")
  if [[ -n "$host" ]] && ! host_resolves "$host"; then
    echo "WARNING: $host does not resolve - the provider has probably retired" >&2
    echo "         this server. Trying anyway; use 'vpnctl random' or 'vpnctl stale'." >&2
  fi

  echo "Stopping any existing OpenVPN..."
  echo "Closing any existing NordVPN connection..."
  $SUDO pkill openvpn 2>/dev/null || true
  $SUDO rm -f "$PIDFILE" 2>/dev/null || true

  echo "Starting OpenVPN using: $DEFAULT_CONF"
  echo "NordVPN Connecting..."

  $SUDO mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  $SUDO openvpn \
    --config "$DEFAULT_CONF" \
    --auth-user-pass "$AUTH_FILE" \
    --log-append "$LOG_FILE" &

  openvpn_pid=$!
  echo "OpenVPN PID: $openvpn_pid (log: $LOG_FILE)"
  $SUDO mkdir -p "$(dirname "$PIDFILE")" || true
  echo "$openvpn_pid" | $SUDO tee "$PIDFILE" >/dev/null || true

  # Wait for the tunnel instead of a fixed sleep. Without this a dead remote
  # leaves openvpn retrying forever while the waybar block says VPN OFF, and
  # nothing tells the user why. /proc is used for liveness because the child
  # runs as root, so `kill -0` would fail with EPERM even while it is alive.
  local waited=0
  while (( waited < CONNECT_TIMEOUT )); do
    if ip link show tun0 >/dev/null 2>&1; then
      break
    fi
    if [[ ! -d "/proc/$openvpn_pid" ]]; then
      break
    fi
    sleep 1
    (( waited++ ))
  done

  if ip link show tun0 >/dev/null 2>&1; then
    echo "Connected after ${waited}s."
    vpn_status
    nudge_waybar
    return 0
  fi

  if [[ -d "/proc/$openvpn_pid" ]]; then
    echo "ERROR: no tun0 after ${CONNECT_TIMEOUT}s - server unreachable (retired?). Stopping openvpn." >&2
    $SUDO kill "$openvpn_pid" 2>/dev/null || true
    $SUDO pkill openvpn 2>/dev/null || true
  else
    echo "ERROR: openvpn exited before the tunnel came up (auth or config problem?)." >&2
  fi
  $SUDO rm -f "$PIDFILE" 2>/dev/null || true
  echo "Last log lines ($LOG_FILE):" >&2
  $SUDO tail -n 15 "$LOG_FILE" 2>/dev/null | sed 's/^/  /' >&2
  nudge_waybar
  return 1
}

vpn_up() {
  # Foreground variant of vpn_on: exec openvpn as PID 1 of this process so
  # systemd (Type=simple) can track, stop, and restart it cleanly. No PID
  # file, no trailing status poll, no & backgrounding.
  local cfgname="${1:-}"

  if [[ -n "$cfgname" ]]; then
    local src="${OVPN_DIR}/${cfgname}"
    if [[ ! -f "$src" ]]; then
      echo "Config not found: $src" >&2
      exit 1
    fi
    $SUDO ln -sf "$src" "$DEFAULT_CONF"
  fi

  $SUDO pkill openvpn 2>/dev/null || true
  $SUDO rm -f "$PIDFILE" 2>/dev/null || true

  exec $SUDO openvpn \
    --config "$DEFAULT_CONF" \
    --auth-user-pass "$AUTH_FILE"
}

vpn_off() {
  echo "Stopping OpenVPN..."
  echo "NordVPN Connection Closed..."
  if [[ -f "$PIDFILE" ]]; then
    $SUDO kill "$(cat "$PIDFILE")" 2>/dev/null || true
    $SUDO rm -f "$PIDFILE"
  fi
  $SUDO pkill openvpn 2>/dev/null || true
  sleep 1   # let tun0 tear down before the indicator re-reads it
  nudge_waybar
}

vpn_list() {
  if [[ ! -d "$OVPN_DIR" ]]; then
    echo "OVPN dir not found: $OVPN_DIR" >&2
    exit 1
  fi
  if [[ $# -ge 1 ]]; then
    ls "$OVPN_DIR"/*.ovpn 2>/dev/null | grep -i "$1" || true
  else
    ls "$OVPN_DIR"/*.ovpn 2>/dev/null || true
  fi
}

vpn_random() {
  if [[ ! -d "$OVPN_DIR" ]]; then
    echo "OVPN dir not found: $OVPN_DIR" >&2
    exit 1
  fi
  local cfg host tries=0
  while (( tries < RANDOM_TRIES )); do
    if command -v shuf >/dev/null 2>&1; then
      cfg=$(ls "$OVPN_DIR"/*.ovpn 2>/dev/null | shuf -n1)
    else
      cfg=$(ls "$OVPN_DIR"/*.ovpn 2>/dev/null | sort -R | head -n1)
    fi
    [[ -z "$cfg" ]] && { echo "No .ovpn files found"; exit 1; }
    host=$(cfg_host "$cfg")
    if host_resolves "$host"; then
      break
    fi
    echo "Skipping $(basename "$cfg"): $host does not resolve (retired server)"
    cfg=""
    (( tries++ ))
  done
  if [[ -z "$cfg" ]]; then
    echo "No live server found in $RANDOM_TRIES picks. The config pool looks stale;" >&2
    echo "run 'vpnctl stale' to list dead configs, or download a fresh set." >&2
    exit 1
  fi
  cfg=$(basename "$cfg")
  echo "Randomly selected server: $cfg"
  vpn_on "$cfg"
}

vpn_stale() {
  # Print configs whose server hostname no longer resolves. Providers retire
  # servers without notice; a pool downloaded months ago can be a third dead.
  # DNS lookups run in parallel so thousands of configs finish in a minute.
  if [[ ! -d "$OVPN_DIR" ]]; then
    echo "OVPN dir not found: $OVPN_DIR" >&2
    exit 1
  fi
  local total
  total=$(ls "$OVPN_DIR"/*.ovpn 2>/dev/null | wc -l)
  echo "Checking DNS for $total configs in $OVPN_DIR ..." >&2
  export -f cfg_host host_resolves
  ls "$OVPN_DIR"/*.ovpn 2>/dev/null \
    | xargs -P 32 -I{} bash -c 'host_resolves "$(cfg_host "$1")" || basename "$1"' _ {} \
    | sort
}

vpn_use() {
  if [[ -z "${1:-}" ]]; then
    echo "Usage: vpnctl use <ovpn_filename>" >&2
    exit 1
  fi
  local src="${OVPN_DIR}/$1"
  if [[ ! -f "$src" ]]; then
    echo "Config not found: $src" >&2
    exit 1
  fi
  $SUDO ln -sf "$src" "$DEFAULT_CONF"
  echo "Default NordVPN config now: $1"
}

vpn_pick() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not installed; falling back to vpnctl list" >&2
    vpn_list
    exit 0
  fi
  local choice
  choice=$(vpn_list | fzf --prompt="Pick NordVPN server: " --height=40%) || exit 1
  choice=$(basename "$choice")
  vpn_on "$choice"
}

vpn_locs() {
  if [[ ! -d "$OVPN_DIR" ]]; then
    echo "OVPN dir not found: $OVPN_DIR" >&2
    exit 1
  fi
  ls "$OVPN_DIR"/*.ovpn 2>/dev/null \
    | sed 's#.*/##; s/\..*//' \
    | sed 's/[0-9].*$//' \
    | sort -u
}

# --- KILLSWITCH (IPv4 + IPv6) ---------------------------------------------

killswitch_on() {
    local dev="${VPN_DEV:-tun0}"

    echo "Enabling killswitch: blocking NEW outbound traffic not via ${dev}..."

    # IPv4 rules
    $SUDO iptables -I OUTPUT -o "${dev}" -m conntrack --ctstate NEW -j ACCEPT
    $SUDO iptables -I OUTPUT ! -o "${dev}" -m conntrack --ctstate NEW -j REJECT

    # IPv6 rules (best-effort; harmless if IPv6 is disabled)
    if command -v ip6tables >/dev/null 2>&1; then
        $SUDO ip6tables -I OUTPUT -o "${dev}" -m conntrack --ctstate NEW -j ACCEPT || true
        $SUDO ip6tables -I OUTPUT ! -o "${dev}" -m conntrack --ctstate NEW -j REJECT || true
    fi

    $SUDO touch "$KS_MARK" 2>/dev/null || true
    echo "Killswitch enabled."
    nudge_waybar
}

killswitch_off() {
    local dev="${VPN_DEV:-tun0}"

    echo "Disabling killswitch (removing rules)..."

    # IPv4
    $SUDO iptables -D OUTPUT ! -o "${dev}" -m conntrack --ctstate NEW -j REJECT 2>/dev/null || true
    $SUDO iptables -D OUTPUT -o "${dev}" -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || true

    # IPv6
    if command -v ip6tables >/dev/null 2>&1; then
        $SUDO ip6tables -D OUTPUT ! -o "${dev}" -m conntrack --ctstate NEW -j REJECT 2>/dev/null || true
        $SUDO ip6tables -D OUTPUT -o "${dev}" -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || true
    fi

    $SUDO rm -f "$KS_MARK" 2>/dev/null || true
    echo "Killswitch disabled."
    nudge_waybar
}

killswitch_status() {
    local dev="${VPN_DEV:-tun0}"
    local v4 v6

    v4=$($SUDO iptables -S OUTPUT 2>/dev/null | grep -F "! -o ${dev}" | grep -F " -j REJECT" || true)
    if command -v ip6tables >/dev/null 2>&1; then
        v6=$($SUDO ip6tables -S OUTPUT 2>/dev/null | grep -F "! -o ${dev}" | grep -F " -j REJECT" || true)
    fi

    # Re-sync the marker with reality in case rules were changed by hand
    if [[ -n "$v4" || -n "$v6" ]]; then
        $SUDO touch "$KS_MARK" 2>/dev/null || true
    else
        $SUDO rm -f "$KS_MARK" 2>/dev/null || true
    fi
    nudge_waybar

    if [[ -n "$v4" || -n "$v6" ]]; then
        echo "Killswitch: ENABLED"
        [[ -n "$v4" ]] && echo "  IPv4 rule: $v4"
        [[ -n "$v6" ]] && echo "  IPv6 rule: $v6"
    else
        echo "Killswitch: DISABLED"
    fi
}

vpn_menu() {
  # Needs wofi
  if ! command -v wofi >/dev/null 2>&1; then
    echo "wofi not installed" >&2
    exit 1
  fi

  # Toggle behavior: if a wofi is already open, close it and exit
  if pgrep -x wofi >/dev/null; then
    pkill -x wofi
    exit 0
  fi

  # Build menu entries
  choice="$(
    printf '%s\n' \
      "Connect (default)" \
      "Connect (random)" \
      "Pick server" \
      "Disconnect" \
      "Killswitch ON" \
      "Killswitch OFF" \
      "Killswitch status" \
      "Full status (terminal)" \
    | wofi --dmenu \
           --prompt 'VPN' \
           --location 3 \
           --insensitive \
           --width 550 \
           --height 450 \
           --xoffset -55 \
           --yoffset 10
  )" || exit 0

  # Connect windows auto-close on success but stay open on failure so the
  # error and log tail from `vpnctl on` can actually be read.
  local hold='echo; stty sane; read -n1 -rp "Press any key to close..."'
  local on_ok="sleep 2"
  local on_fail="{ $hold; }"

  case "$choice" in
    "Connect (default)")
      kitty --class vpnstatus -e bash -c "vpnctl on && $on_ok || $on_fail"
      ;;
    "Connect (random)")
      kitty --class vpnstatus -e bash -c "vpnctl random && $on_ok || $on_fail"
      ;;
    "Pick server")
      cfg="$(
        vpn_list | sed 's#.*/##' | wofi --dmenu \
          --prompt 'Pick server' \
          --location 3 \
          --insensitive \
          --width 550 \
          --height 450 \
          --xoffset -55 \
          --yoffset 10
      )" || exit 0
      cfg=$(basename "$cfg")
      if [[ -n "$cfg" ]]; then
        kitty --class vpnstatus -e bash -c "vpnctl on \"$cfg\" && $on_ok || $on_fail"
      fi
      ;;

    "Disconnect")
      kitty --class vpnstatus -e bash -c "vpnctl off; echo; read -n1 -rp 'Press any key to close...'"
      ;;
    "Killswitch ON")
      kitty --class vpnstatus -e bash -c "vpnctl killswitch on; echo; read -n1 -rp 'Press any key to close...'"
      ;;
    "Killswitch OFF")
      kitty --class vpnstatus -e bash -c "vpnctl killswitch off; echo; read -n1 -rp 'Press any key to close...'"
      ;;
    "Killswitch status")
      kitty --class vpnstatus -e bash -c "vpnctl killswitch stat; echo; read -n1 -rp 'Press any key to close...'"
      ;;
    "Full status (terminal)")
      kitty --class vpnstatus -e bash -c "vpnctl status; echo; read -n1 -rp 'Press any key to close...'"
      ;;
    *)
      # No-op / cancelled
      ;;
  esac
}

# ========= dispatch =========

cmd="${1:-}"
shift || true

case "$cmd" in
  on)         vpn_on "$@" ;;
  up)         vpn_up "$@" ;;
  off)        vpn_off "$@" ;;
  status)     vpn_status ;;
  list)       vpn_list "$@" ;;
  random)     vpn_random ;;
  stale)      vpn_stale ;;
  use)        vpn_use "$@" ;;
  pick)       vpn_pick ;;
  locs)       vpn_locs ;;
  menu)       vpn_menu ;;
  killswitch)
    sub="${1:-}"
    shift || true
    case "$sub" in
      on)   killswitch_on "$@" ;;
      off)  killswitch_off "$@" ;;
      stat) killswitch_status ;;
      *)    echo "Usage: vpnctl killswitch {on|off|stat}" >&2; exit 1 ;;
    esac
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
esac


