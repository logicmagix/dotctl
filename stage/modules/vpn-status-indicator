#!/usr/bin/env bash

CONFIG_DIR="/etc/openvpn"
DEFAULT_CONF="${CONFIG_DIR}/nordvpn.conf"

state="off"
loc=""

# tun0 present → VPN is ON
if ip link show tun0 >/dev/null 2>&1; then
  state="on"
fi

# Get endpoint only if ON
if [[ "$state" == "on" && -e "$DEFAULT_CONF" ]]; then
  target=$(readlink -f "$DEFAULT_CONF" 2>/dev/null || echo "")
  if [[ -n "$target" ]]; then
    base=$(basename "$target")    # us1234.nordvpn.com.udp.ovpn
    cc="${base%%[0-9]*}"           # us
    cc="${cc,,}"
    loc="${cc^^}"
  fi
fi

# Detect killswitch
ks="false"
if iptables -S OUTPUT 2>/dev/null | grep -q '! -o tun0' | grep -q ' -j REJECT'; then
  ks="true"
fi

classes="$state"
[[ "$ks" == "true" ]] && classes="$classes killswitch"

# The VPN separators render this state but only re-exec on RTMIN+9
# ("interval": "once" in the waybar config), so nudge them the moment the
# class flips - polling on separate timers left the vpn block and its
# separators flipping up to an interval apart. First run only seeds the
# cache: signaling would re-exec every startup poller for nothing.
state_file="${XDG_RUNTIME_DIR:-/tmp}/dotctl-vpn.class"
prev=""
[[ -r "$state_file" ]] && prev=$(<"$state_file")
if [[ "$classes" != "$prev" ]]; then
  if printf '%s' "$classes" > "$state_file" 2>/dev/null; then
    [[ -n "$prev" ]] && pkill -RTMIN+9 -x waybar 2>/dev/null
  fi
fi

# Icons as JSON \uXXXX escapes (waybar parses this output as JSON) - literal
# PUA glyphs are invisible in editors and get silently dropped by tooling.
if [[ "$state" == "on" ]]; then
  text='\uf023 VPN'
  [[ -n "$loc" ]] && text+=" ${loc}"
  alt="on"
else
  text='\uf09c VPN OFF'
  alt="off"
fi

# Tooltip
tooltip="VPN ${state^^}"
[[ -n "$loc" ]] && tooltip="$tooltip | Endpoint: ${loc}"
[[ "$ks" == "true" ]] && tooltip="$tooltip | Killswitch: ON"

printf '{"text":"%s","tooltip":"%s","class":"%s","alt":"%s"}\n' \
  "$text" "$tooltip" "$classes" "$alt"

