#!/usr/bin/env bash
# Unified audio control: switch outputs, toggle mute.
#
# Profiles are resolved at runtime from a mix of port type, sink name and
# sink description reported by pactl - no hardcoded sink names. Works on
# any system with pulseaudio or pipewire-pulse.
#
# Matching priority (first hit wins):
#   headset : bluez_output.* → port type Headphones|Headset → description
#             matches a known wireless/bluetooth headset brand (Barracuda,
#             Arctis, HyperX, Jabra, AirPods, ...). USB "Headset Adapter"
#             dongles are explicitly excluded from the brand match so they
#             stay available as plain analog aux outputs.
#   hdmi    : port type HDMI → sink name contains "hdmi".
#   speaker : alias for hdmi (most desktop "speakers" are the monitor via
#             HDMI/DP). Falls back to any non-headset analog sink.
#   aux     : port type Aux|Line → any remaining analog sink that is not
#             already claimed as headset or HDMI.
#   bluetooth: any bluez_output.* sink (paired bluetooth audio device).
#
# Actions (not profiles): toggle-mute, and heal - un-stick WirePlumber when
# its effective default sink stops following the configured one after resume.
#
# Override any of the above with environment regexes (extended regex,
# checked against both sink name and description):
#   DOTCTL_AUDIO_HEADSET_MATCH, DOTCTL_AUDIO_HDMI_MATCH, DOTCTL_AUDIO_AUX_MATCH

set -euo pipefail

PROFILE="${1:-}"

notify() { notify-send "$@" 2>/dev/null || true; }

if [ -z "$PROFILE" ]; then
  notify "Audio" "Usage: audio-output {headset|hdmi|speaker|aux|usb|bluetooth|toggle-mute|heal}"
  exit 1
fi

if [ "$PROFILE" = "toggle-mute" ]; then
  pactl set-sink-mute @DEFAULT_SINK@ toggle
  state=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')
  if [ "$state" = "yes" ]; then
    notify "🔇 Muted" ""
  else
    notify "🔊 Unmuted" ""
  fi
  exit 0
fi

# ---- stuck-default recovery ---------------------------------------------------
#
# WirePlumber can wedge on a sink that went away and came back under it (HDMI
# across a DPMS-off + suspend/resume): the *configured* default is the HDMI
# sink but the effective default stays on the fallback it picked while the
# monitor was off. Re-requesting the default is a no-op because the configured
# value doesn't change - so pavucontrol can't fix it either. Bouncing the card
# profile makes WirePlumber rebuild the sink and re-select.

# Wait up to ~1s for the effective default to become $1.
default_is() {
  local i
  for i in 1 2 3 4 5; do
    [ "$(pactl get-default-sink 2>/dev/null)" = "$1" ] && return 0
    sleep 0.2
  done
  return 1
}

bounce_card_of() {
  local sink="$1" card profile
  card=$(pactl list sinks 2>/dev/null | awk -v s="$sink" '
    $1=="Name:"              { k=($2==s) }
    k && $1=="device.name"   { gsub(/"/,"",$3); print $3; exit }
  ')
  profile=$(pactl list cards 2>/dev/null | awk -v c="${card:-}" '
    $1=="Name:"                          { k=($2==c) }
    k && $1=="Active" && $2=="Profile:"  { print $3; exit }
  ')
  [ -n "${card:-}" ] && [ -n "${profile:-}" ] && [ "$profile" != "off" ] || return 1
  pactl set-card-profile "$card" off 2>/dev/null || true
  sleep 0.5
  pactl set-card-profile "$card" "$profile" 2>/dev/null || true
  sleep 1
}

# Sink $1 exists and its active port is not reported unplugged. A configured
# default that fails this (monitor off, headset away) is legitimately skipped.
sink_usable() {
  pactl list sinks 2>/dev/null | awk -v s="$1" '
    $1=="Name:"                           { k=($2==s); inports=0; if (k) found=1 }
    k && /^[[:space:]]+Ports:/            { inports=1; next }
    k && inports && /type:/               { p=$1; sub(/:$/,"",p); if ($0 ~ /not available/) na[p]=1 }
    k && $1=="Active" && $2=="Port:"      { inports=0; if ($3 in na) bad=1 }
    END                                   { exit (found && !bad) ? 0 : 1 }
  '
}

# heal: if the configured default sink is usable but WirePlumber isn't using
# it, bounce its card. Silent no-op otherwise, so it is safe to run blindly
# after resume (e.g. from hypridle's after_sleep_cmd).
if [ "$PROFILE" = "heal" ]; then
  command -v pw-metadata >/dev/null 2>&1 || exit 0
  want=$(pw-metadata -n default 0 default.configured.audio.sink 2>/dev/null \
    | sed -n "s/.*key:'default\.configured\.audio\.sink'.*\"name\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
    | head -n1)
  [ -n "$want" ] || exit 0
  sink_usable "$want" || exit 0
  default_is "$want" && exit 0

  # Streams already playing on the sink get kicked off by the bounce; remember
  # them so they can be put back. Streams parked elsewhere are left alone.
  want_idx=$(pactl list short sinks 2>/dev/null | awk -v s="$want" '$2==s {print $1; exit}')
  moved=$(pactl list short sink-inputs 2>/dev/null | awk -v i="${want_idx:-x}" '$2==i {print $1}')
  bounce_card_of "$want" || exit 0
  if default_is "$want"; then
    for id in $moved; do pactl move-sink-input "$id" "$want" 2>/dev/null || true; done
    notify "🔊 Audio recovered" "Default output restored to $want"
    exit 0
  fi
  notify "Audio" "Default sink stuck on $(pactl get-default-sink 2>/dev/null) - restart wireplumber"
  exit 1
fi

: "${DOTCTL_AUDIO_HEADSET_MATCH:=}"
: "${DOTCTL_AUDIO_HDMI_MATCH:=}"
: "${DOTCTL_AUDIO_AUX_MATCH:=}"

# Brand names that indicate a real wireless/bluetooth headset rather than
# a generic analog dongle. Extended regex, case-insensitive.
HEADSET_BRANDS='Barracuda|Arctis|HyperX|SteelSeries|Kraken|BlackShark|Nari|Astro A[0-9]|AirPods|QuietComfort|Bose QC|WH-1000|WF-1000|Jabra (Evolve|Elite)|Corsair (HS|Void)|Logitech G[0-9]|Beats|Plantronics|Poly Voyager|JBL Quantum|Sennheiser|Turtle Beach|EPOS|Bluetooth'

# Emit "sink|port_id|port_type|description" rows for every port of every sink.
rows=$(pactl list sinks 2>/dev/null | awk '
  /^Sink #/                   { sink=""; desc=""; inports=0; next }
  $1=="Name:"                 { sink=$2; inports=0; next }
  $1=="Description:"          { sub(/^[[:space:]]*Description:[[:space:]]*/, ""); desc=$0; next }
  /^[[:space:]]+Ports:/       { inports=1; next }
  $1=="Active" && $2=="Port:" { inports=0; next }
  inports && /type:/ {
    pid=$1; sub(/:$/, "", pid)
    if (match($0, /type: [A-Za-z-]+/)) {
      t=substr($0, RSTART+6, RLENGTH-6)
      if (sink != "") print sink "|" pid "|" t "|" desc
    }
  }
')

# ---- matchers ---------------------------------------------------------------

# Case-insensitive extended-regex match on "$1 $2" (combined haystack).
rx_ci() {
  local hay="$1" pat="$2"
  [ -z "$pat" ] && return 1
  shopt -s nocasematch
  if [[ "$hay" =~ $pat ]]; then shopt -u nocasematch; return 0; fi
  shopt -u nocasematch
  return 1
}

is_headset_brand_row() {
  local s="$1" t="$2" d="$3"
  rx_ci "$s $d" "$DOTCTL_AUDIO_HEADSET_MATCH" && return 0
  [[ "$s" =~ ^bluez_output\. ]] && return 0
  # Brand-name match - skip USB "Headset Adapter" dongles
  if ! rx_ci "$d" "Adapter"; then
    rx_ci "$d" "$HEADSET_BRANDS" && return 0
  fi
  return 1
}

is_headset_port_row() {
  local s="$1" t="$2" d="$3"
  # Port type match for generic headphones (fallback)
  [[ "$t" == "Headphones" || "$t" == "Headset" ]] && return 0
  return 1
}

# Combined check for exclusions (aux/speaker need to exclude headset brands only)
# Port type "Headphones" on built-in audio should NOT count as headset - that's just
# aux with headphones plugged in. Only brand-matched devices are true headsets.
is_headset_row() {
  is_headset_brand_row "$@"
}

is_hdmi_row() {
  local s="$1" t="$2" d="$3"
  rx_ci "$s $d" "$DOTCTL_AUDIO_HDMI_MATCH" && return 0
  [[ "$t" == "HDMI" ]] && return 0
  [[ "$s" == *hdmi* ]] && return 0
  return 1
}

is_analog_row() {
  local t="$1"
  case "$t" in
    Analog|Aux|Line|Speaker) return 0 ;;
    *) return 1 ;;
  esac
}

# Iterate rows and return the first matching "sink|port_id". Caller provides
# the predicate name. Extra predicate names prefixed with "!" mean "must NOT
# match" - used to exclude headset/hdmi rows from the aux fallback.
pick_row() {
  local primary="$1"; shift
  local excludes=("$@")
  local s p t d ex
  while IFS='|' read -r s p t d; do
    [ -z "$s" ] && continue
    "$primary" "$s" "$t" "$d" || continue
    local skip=0
    for ex in "${excludes[@]}"; do
      if "$ex" "$s" "$t" "$d"; then skip=1; break; fi
    done
    [ "$skip" -eq 0 ] && { printf '%s|%s|%s\n' "$s" "$p" "$d"; return 0; }
  done <<<"$rows"
  return 1
}

# aux predicate: analog port type, with env override allowed.
is_aux_row() {
  local s="$1" t="$2" d="$3"
  rx_ci "$s $d" "$DOTCTL_AUDIO_AUX_MATCH" && return 0
  is_analog_row "$t"
}

is_bluetooth_row() {
  local s="$1"
  [[ "$s" =~ ^bluez_output\. ]]
}

is_usb_audio_row() {
  local s="$1"
  [[ "$s" =~ ^alsa_output\.usb- ]]
}

case "$PROFILE" in
  headset)
    label='Headset'; icon='🎧'
    # Only brand-matched headsets (Barracuda, etc.) - not built-in audio with headphones plugged in
    picked=$(pick_row is_headset_brand_row || true)
    ;;
  hdmi)
    label='HDMI Output'; icon='🖥️'
    picked=$(pick_row is_hdmi_row || true)
    ;;
  speaker)
    label='Speakers'; icon='🖥️'
    picked=$(pick_row is_hdmi_row || true)
    # Speaker fallback: any analog sink that is neither headset nor HDMI.
    if [ -z "$picked" ]; then
      picked=$(pick_row is_aux_row is_headset_row is_hdmi_row || true)
    fi
    ;;
  aux)
    label='AUX / Analog'; icon='🎚️'
    # Prefer built-in audio for aux (pci-* sinks), fall back to USB audio
    picked=$(pick_row is_aux_row is_headset_row is_hdmi_row is_usb_audio_row || true)
    if [ -z "$picked" ]; then
      picked=$(pick_row is_aux_row is_headset_row is_hdmi_row || true)
    fi
    ;;
  usb)
    label='USB Audio'; icon='🔌'
    # Generic USB audio adapters (USB-to-aux cables, etc.) - excludes brand headsets
    picked=$(pick_row is_usb_audio_row is_headset_brand_row || true)
    ;;
  bluetooth|bluez|bt)
    label='Bluetooth'; icon='🔵'
    picked=$(pick_row is_bluetooth_row || true)
    ;;
  *)
    notify "Audio" "Unknown action: $PROFILE"; exit 1 ;;
esac

if [ -z "${picked:-}" ]; then
  notify "Audio" "No sink matching '$label' on this system"
  exit 1
fi

IFS='|' read -r match_sink match_port match_desc <<<"$picked"

if [ -n "$match_port" ]; then
  pactl set-sink-port "$match_sink" "$match_port" >/dev/null 2>&1 || true
fi

pactl set-default-sink "$match_sink"

if ! default_is "$match_sink"; then
  bounce_card_of "$match_sink"
  if [ -n "$match_port" ]; then
    pactl set-sink-port "$match_sink" "$match_port" >/dev/null 2>&1 || true
  fi
  pactl set-default-sink "$match_sink" 2>/dev/null || true
  if ! default_is "$match_sink"; then
    notify "Audio" "Default sink stuck on $(pactl get-default-sink 2>/dev/null) - restart wireplumber"
    exit 1
  fi
fi

pactl list short sink-inputs 2>/dev/null | awk '{print $1}' \
  | xargs -r -I{} pactl move-sink-input {} "$match_sink" 2>/dev/null || true

notify "$icon $label" "${match_desc:-$match_sink}"
