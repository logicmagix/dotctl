#!/bin/sh

# Toggle: if any wofi is open, close it
if pgrep -x wofi >/dev/null; then
  pkill -x wofi
  exit 0
fi

# Detect init system: systemd, elogind (OpenRC/runit), raw OpenRC, or sysv.
# suspend/hibernate commands are left empty where the init system offers
# nothing unprivileged; the menu then simply omits those entries.
suspend_cmd=""
hibernate_cmd=""
if [ -d /run/systemd/system ]; then
  poweroff_cmd="systemctl poweroff"
  reboot_cmd="systemctl reboot"
  suspend_cmd="systemctl suspend"
  hibernate_cmd="systemctl hibernate"
elif command -v loginctl >/dev/null 2>&1; then
  # elogind on OpenRC/runit: polkit-authorized, no root required.
  poweroff_cmd="loginctl poweroff"
  reboot_cmd="loginctl reboot"
  suspend_cmd="loginctl suspend"
  hibernate_cmd="loginctl hibernate"
elif command -v openrc-shutdown >/dev/null 2>&1; then
  poweroff_cmd="openrc-shutdown -p now"
  reboot_cmd="openrc-shutdown -r now"
else
  poweroff_cmd="poweroff"
  reboot_cmd="reboot"
fi
# No logind at all: zzz/ZZZ (Void/runit) are the usual unprivileged helpers.
if [ -z "$suspend_cmd" ] && command -v zzz >/dev/null 2>&1; then
  suspend_cmd="zzz"
fi
if [ -z "$hibernate_cmd" ] && command -v ZZZ >/dev/null 2>&1; then
  hibernate_cmd="ZZZ"
fi

# Only offer what can actually happen. Ask logind first (systemd and elogind
# both answer CanSuspend/CanHibernate over D-Bus): "na" means the kernel or
# setup can't do it - e.g. hibernate with no swap - and "no" means policy
# forbids it; only "yes"/"challenge" keep the entry. Without busctl, fall
# back to the kernel's own list (mem = suspend-to-RAM, disk = hibernate),
# which is less precise: "disk" shows up even with no swap to hibernate to.
logind_can() {
  busctl --no-pager call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager "$1" 2>/dev/null
}
if command -v busctl >/dev/null 2>&1 && [ -n "$suspend_cmd$hibernate_cmd" ]; then
  case "$(logind_can CanSuspend)"   in *'"yes"'*|*'"challenge"'*) ;; *) suspend_cmd="" ;; esac
  case "$(logind_can CanHibernate)" in *'"yes"'*|*'"challenge"'*) ;; *) hibernate_cmd="" ;; esac
else
  kernel_states="$(cat /sys/power/state 2>/dev/null)"
  case " $kernel_states " in *" mem "*) ;; *) suspend_cmd="" ;; esac
  case " $kernel_states " in *" disk "*) ;; *) hibernate_cmd="" ;; esac
fi

# Lock only when hyprlock is installed. Listed first so a stray Enter locks
# the session rather than powering it off.
lock_cmd=""
if command -v hyprlock >/dev/null 2>&1; then
  lock_cmd="hyprlock"
fi

# Build the entry list; ~58px per row + ~60px for the prompt.
entries=""
rows=0
if [ -n "$lock_cmd" ]; then
  entries="󰌾 Lock
"
  rows=1
fi
entries="${entries}󰐥 Poweroff
󰜉 Reboot"
rows=$((rows + 2))
if [ -n "$suspend_cmd" ]; then
  entries="$entries
󰒲 Sleep"
  rows=$((rows + 1))
fi
if [ -n "$hibernate_cmd" ]; then
  entries="$entries
󰤄 Hibernate"
  rows=$((rows + 1))
fi
entries="$entries
󰍃 Logout"
rows=$((rows + 1))
height=$((60 + rows * 58))

# Open a small power menu in the top-left
choice="$(
  printf '%s\n' "$entries" |
  wofi --dmenu \
       --prompt 'Power Menu' \
       --location 1 \
       --insensitive \
       --width 300 \
       --height "$height" \
       --xoffset 10 \
       --yoffset 10
)"

# Runtime detection for Hyprland Lua config (v0.55+).
# Try legacy dispatch first; if it fails with lua parse error, use eval.
hypr_exit() {
  out=$(hyprctl dispatch exit 2>&1)
  if echo "$out" | grep -q "hl.dispatch"; then
    # Lua config detected - use eval syntax
    hyprctl eval 'hl.dispatch(hl.dsp.exit())'
  fi
}

# Run a power command; on failure (e.g. hibernate with no resume device)
# show the error instead of silently doing nothing.
run_power() {
  err="$($1 2>&1)" && return 0
  # elogind's loginctl exits 1 without a word when logind refuses, so give
  # the usual reason rather than "unknown error".
  if [ -z "$err" ]; then
    case "$2" in
      Hibernate) err="not available (no swap large enough, or no resume= device)" ;;
      Sleep)     err="not available (kernel or firmware doesn't support suspend)" ;;
      *)         err="unknown error" ;;
    esac
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "Power menu" "$2 failed: $err"
  else
    printf 'power: %s failed: %s\n' "$2" "$err" >&2
  fi
  return 1
}

# Same guard hypridle uses: a second hyprlock instance refuses to start.
hypr_lock() {
  pidof hyprlock >/dev/null || hyprlock
}

case "$choice" in
  "󰌾 Lock")      hypr_lock ;;
  "󰐥 Poweroff")  run_power "$poweroff_cmd"  "Poweroff" ;;
  "󰜉 Reboot")    run_power "$reboot_cmd"    "Reboot" ;;
  "󰒲 Sleep")     run_power "$suspend_cmd"   "Sleep" ;;
  "󰤄 Hibernate") run_power "$hibernate_cmd" "Hibernate" ;;
  "󰍃 Logout")    hypr_exit ;;
esac
