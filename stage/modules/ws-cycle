#!/usr/bin/env bash
set -euo pipefail

DIR="${1:-next}"     # "next" or "prev"
MIN="${2:-1}"        # lowest workspace number
MAX="${3:-10}"       # highest workspace number

cur="$(hyprctl -j activeworkspace | jq -r '.id')"

# Hyprland >= 0.57 takes Lua in `hyprctl dispatch`; older versions take the
# hyprlang dispatcher form. Pick based on the running compositor's version.
hypr_major_minor="$(hyprctl version -j 2>/dev/null | jq -r '.tag' | sed 's/^v//' | cut -d. -f1,2)"
go_to_workspace() {
  if [[ -n "$hypr_major_minor" ]] && \
     [[ "$(printf '%s\n0.57\n' "$hypr_major_minor" | sort -V | head -1)" == "0.57" ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $1 })"
  else
    hyprctl dispatch workspace "$1"
  fi
}

# If you are on a "special" workspace (negative id), go to MIN
if [[ "$cur" -lt 0 ]]; then
  go_to_workspace "$MIN"
  exit 0
fi

if [[ "$DIR" == "prev" ]]; then
  nxt=$((cur - 1))
  [[ "$nxt" -lt "$MIN" ]] && nxt="$MAX"
else
  nxt=$((cur + 1))
  [[ "$nxt" -gt "$MAX" ]] && nxt="$MIN"
fi

go_to_workspace "$nxt"

