#!/usr/bin/env bash
# waybar-gputemp - print GPU temp + waybar state class (JSON).
# Works with NVIDIA (nvidia-smi), AMD (sensors edge/junction), and any chip that
# exposes a GPU temp via an lm-sensors "GPU" label (e.g. ThinkPad EC on hybrid
# laptops) or a GPU-named hwmon device.
# Output: {"text":"GPU: N°C","class":"normal|warning|critical","alt":"...","tooltip":"<gpu model> (N% load)"}

# The flanking chevrons render this module's state but only re-exec on
# RTMIN+8 ("interval": "once" in the waybar config), so nudge them the
# moment the class flips - polling on separate timers left the block and
# its chevrons flipping up to an interval apart. First run only seeds the
# cache: signaling would re-exec every startup poller for nothing.
notify_state_change() { # <class>
  local f="${XDG_RUNTIME_DIR:-/tmp}/dotctl-gputemp.class" prev=""
  [[ -r "$f" ]] && prev=$(<"$f")
  [[ "$1" == "$prev" ]] && return 0
  printf '%s' "$1" > "$f" 2>/dev/null || return 0
  [[ -n "$prev" ]] && pkill -RTMIN+8 -x waybar 2>/dev/null
  return 0
}

# True if an NVIDIA GPU is present and runtime-suspended (hybrid/Optimus
# laptops power the dGPU down to D3 when idle). nvidia-smi wakes the card on
# every call, so polling it from waybar would keep the dGPU awake permanently
# and burn battery — skip nvidia-smi entirely while the card sleeps.
nvidia_suspended() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ -r "$d/vendor" && $(<"$d/vendor") == 0x10de ]] || continue
    [[ -r "$d/class"  && $(<"$d/class")  == 0x03*  ]] || continue
    [[ -r "$d/power/runtime_status" && $(<"$d/power/runtime_status") == suspended ]] && return 0
  done
  return 1
}

# True when the dGPU's runtime PM is actually armed (power/control == auto).
# TLP sets control=on while on AC, which disables runtime PM outright - the
# card then sits in D0 BY POLICY and there is no autosuspend timer to protect
# and nothing anomalous to report. Every idle check below is gated on this.
rpm_enabled() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ -r "$d/vendor" && $(<"$d/vendor") == 0x10de ]] || continue
    [[ -r "$d/class"  && $(<"$d/class")  == 0x03*  ]] || continue
    [[ -r "$d/power/control" && $(<"$d/power/control") == auto ]] && return 0
  done
  return 1
}

# True when a battery is present at all. Together with an NVIDIA dGPU this
# identifies the hybrid-laptop population the idle alert is meant for -
# desktops and AMD machines never arm it.
has_battery() {
  local d
  for d in /sys/class/power_supply/*; do
    [[ -r "$d/type" && $(<"$d/type") == Battery ]] && return 0
  done
  return 1
}

# True when every mains adapter reports offline (and at least one exists).
# An idling-but-awake dGPU is merely untidy on AC; on battery it is silently
# eating runtime, which is the only case worth interrupting the user for.
on_battery() {
  local d found=1
  for d in /sys/class/power_supply/*; do
    [[ -r "$d/type" && $(<"$d/type") == Mains && -r "$d/online" ]] || continue
    found=0
    [[ $(<"$d/online") == 1 ]] && return 1
  done
  return $found
}

# nvidia-smi resets the card's runtime-PM autosuspend timer on every call, so
# polling it at the waybar interval (2s for this module) can pin an otherwise
# idle card awake - the module then perpetuates the very state it reports.
# Cache the reading instead and refresh at most every NVSMI_TTL seconds: the
# output stays correct at ANY waybar interval, and the driver gets long quiet
# gaps in which the card can actually reach D3.
NVSMI_TTL=${DOTCTL_NVSMI_TTL:-15}
nvsmi_cache="${XDG_RUNTIME_DIR:-/tmp}/dotctl-gputemp.cache"

cache_read() {
  local mtime now line
  [[ -r "$nvsmi_cache" ]] || return 1
  mtime=$(stat -c %Y "$nvsmi_cache" 2>/dev/null) || return 1
  now=$(date +%s)
  (( now - mtime < NVSMI_TTL )) || return 1
  line=$(<"$nvsmi_cache") || return 1
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line"
}

# GPU model name for the tooltip, resolved from the PCI ID database. Reads only
# cached sysfs attributes (vendor/device/class), never PCI config space or
# nvidia-smi, so a runtime-suspended dGPU stays asleep. Prefers a non-Intel
# chip on hybrid machines since that's whose temp this module reports.
gpu_name() {
  local ids="" f d v ven="" dev="" n
  for f in /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids; do
    [[ -r "$f" ]] && { ids="$f"; break; }
  done
  [[ -n "$ids" ]] || return 1
  for d in /sys/bus/pci/devices/*; do
    [[ -r "$d/class" && $(<"$d/class") == 0x03* ]] || continue
    v=$(<"$d/vendor")
    if [[ -z "$ven" || "$ven" == "0x8086" ]]; then
      ven="$v"; dev=$(<"$d/device")
    fi
  done
  [[ -n "$ven" ]] || return 1
  n=$(awk -v ven="${ven#0x}" -v dev="${dev#0x}" '
    {
      if (substr($0,1,1) == "\t") {
        if (invend && substr($0,2,1) != "\t" && tolower(substr($0,2,4)) == dev) {
          print substr($0,8); exit
        }
      } else if (substr($0,1,1) != "#") {
        invend = (tolower(substr($0,1,4)) == ven)
      }
    }' "$ids")
  [[ -n "$n" ]] || return 1
  # pci.ids names chips like "AD107 [GeForce RTX 4060]" - keep the retail name
  [[ "$n" == *\[*\]* ]] && { n="${n#*\[}"; n="${n%%\]*}"; }
  printf '%s\n' "${n//&/&amp;}"
}

# GPU utilization in percent for the non-NVIDIA paths, from the amdgpu-style
# sysfs attribute (also exposed by some other drivers). Nothing to print on
# chips that don't have it - the tooltip then just carries the model name.
sysfs_load() {
  local d v
  for d in /sys/class/drm/card*/device; do
    [[ -r "$d/gpu_busy_percent" ]] || continue
    v=$(<"$d/gpu_busy_percent")
    [[ "$v" =~ ^[0-9]+$ ]] && { printf '%s\n' "$v"; return 0; }
  done
  return 1
}

# Prints "<temp> <load>", where <load> is a utilization percentage or "-" when
# the source can't report one, or the bare word "sleeping".
pick_temp() {
  local t="" l="" out=""

  # NVIDIA — but never wake a sleeping dGPU just to read its temperature
  if command -v nvidia-smi >/dev/null 2>&1; then
    if nvidia_suspended; then
      printf 'sleeping\n'; return 0
    fi
    # Nothing holds the card: a leftover wake, a driver probe, or simply an
    # unused dGPU that AC policy is keeping powered. Either way nothing is
    # rendering on it, so report it without calling nvidia-smi - asking for a
    # temperature would reset the autosuspend timer where one is still armed,
    # and there is no reading worth having where one isn't.
    if ! fuser -s /dev/nvidiactl 2>/dev/null; then
      printf 'idle\n'; return 0
    fi
    # A client holds the device. Note this does NOT mean the card is doing
    # work: anything that merely dlopens NVIDIA's Vulkan ICD (libGLX_nvidia.so,
    # loaded by any Vulkan device enumeration - GTK4's default renderer does
    # this) holds /dev/nvidia* open for its whole lifetime while rendering
    # nothing. The 0%-load check downstream is what tells those two apart.
    if out=$(cache_read); then
      printf '%s\n' "$out"; return 0
    fi
    # One query for both fields: a second nvidia-smi call per poll would
    # double the wake-up cost on a card we're trying to leave alone.
    read -r t l < <(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu \
      --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ',%')
    if [[ "$t" =~ ^[0-9]+$ ]]; then
      [[ "$l" =~ ^[0-9]+$ ]] || l="-"
      # Cache write is best-effort and kept off stdout: the reading must be
      # printed exactly once even when the runtime dir isn't writable.
      { printf '%s %s\n' "$t" "$l" > "$nvsmi_cache"; } 2>/dev/null || true
      printf '%s %s\n' "$t" "$l"
      return 0
    fi
  fi

  # lm-sensors: GPU temp under a recognizable label.
  #   edge/junction -> AMD;  GPU -> ThinkPad EC and other labeled sensors.
  # Case-insensitive match on the label so it works across chips/drivers. This
  # also covers hybrid/Optimus laptops where nvidia-smi can't read a driverless
  # dGPU but the EC still reports a GPU temperature.
  if command -v sensors >/dev/null 2>&1; then
    t=$(sensors 2>/dev/null | awk 'tolower($1) ~ /^(edge|junction|gpu):$/ {gsub(/[+°C]/,"",$2); print int($2); exit}')
    if [[ -n "$t" && "$t" =~ ^[0-9]+$ ]]; then
      l="$(sysfs_load || true)"; [[ -n "$l" ]] || l="-"
      printf '%s %s\n' "$t" "$l"; return 0
    fi
  fi

  # hwmon fallback: any device with "gpu" in its name
  local d name input
  for d in /sys/class/hwmon/hwmon*; do
    [[ -r "$d/name" ]] || continue
    name=$(<"$d/name")
    if [[ "$name" == *gpu* || "$name" == amdgpu || "$name" == nouveau || "$name" == radeon || "$name" == nvidia || "$name" == i915 ]]; then
      input=$(ls "$d"/temp*_input 2>/dev/null | head -n1)
      if [[ -r "$input" ]]; then
        t=$(<"$input")
        if [[ -n "$t" ]]; then
          l="$(sysfs_load || true)"; [[ -n "$l" ]] || l="-"
          printf '%s %s\n' $((t / 1000)) "$l"; return 0
        fi
      fi
    fi
  done

  return 1
}

# --- awake-but-doing-nothing tracking --------------------------------------
# A dGPU sitting in D0 at 0% load is the signature of something holding
# /dev/nvidia* open without rendering. It costs a couple of watts and nothing
# on the bar used to say so: a plain temperature reading looks entirely normal,
# which is how a card stayed awake through a full day on battery. Require the
# condition to persist before flagging it, so a single 0% sample between frames
# mid-game doesn't flicker the module.
idle_since_f="${XDG_RUNTIME_DIR:-/tmp}/dotctl-gputemp.idle-since"
idle_alerted_f="${XDG_RUNTIME_DIR:-/tmp}/dotctl-gputemp.idle-alerted"
IDLE_SHOW=${DOTCTL_GPU_IDLE_SHOW:-60}          # seconds before the bar flags it
IDLE_ALERT_AFTER=${DOTCTL_GPU_IDLE_ALERT_AFTER:-300}   # seconds before notifying

# Prints how many seconds the idle-but-awake condition has held (0 when clear).
idle_held() { # <1 if idle now, else 0>
  local now since
  now=$(date +%s)
  if [[ "$1" != 1 ]]; then
    rm -f "$idle_since_f" "$idle_alerted_f" 2>/dev/null
    printf '0\n'; return 0
  fi
  if [[ -r "$idle_since_f" ]]; then
    since=$(<"$idle_since_f")
  else
    since="$now"; printf '%s' "$now" > "$idle_since_f" 2>/dev/null
  fi
  [[ "$since" =~ ^[0-9]+$ ]] || since="$now"
  printf '%s\n' $(( now - since ))
}

# Notify once per episode, and only for the machines this can actually hurt:
# a battery must exist (hybrid laptop, not a desktop) and be discharging.
# Set DOTCTL_GPU_IDLE_ALERT=0 to silence it.
maybe_alert() { # <held-seconds>
  [[ "${DOTCTL_GPU_IDLE_ALERT:-1}" == 0 ]] && return 0
  (( $1 >= IDLE_ALERT_AFTER )) || return 0
  rpm_enabled  || return 0
  has_battery  || return 0
  on_battery   || return 0
  [[ -e "$idle_alerted_f" ]] && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  : > "$idle_alerted_f" 2>/dev/null
  notify-send -u critical -a dotctl "dGPU awake on battery" \
    "Idle but powered up for $(( $1 / 60 )) min - something holds /dev/nvidia* open.\nCheck with: fuser -v /dev/nvidia*" \
    2>/dev/null
  return 0
}

out="$(pick_temp || true)"

name="$(gpu_name || true)"
[[ -n "$name" ]] || name="GPU"

read -r temp load <<< "$out"
# Sources that can't report utilization leave the tooltip at the model alone.
[[ "$load" =~ ^[0-9]+$ ]] && name="$name ($load% load)"

if [[ -z "$temp" ]]; then
  notify_state_change unknown
  printf '{"text":"GPU: --","class":"unknown","alt":"unknown","tooltip":"%s"}\n' "$name"
  exit 0
fi

if [[ "$temp" == "sleeping" ]]; then
  idle_held 0 >/dev/null
  notify_state_change normal
  printf '{"text":"GPU: zzz","class":"normal","alt":"sleeping","tooltip":"%s (suspended)"}\n' "$name"
  exit 0
fi

# Awake with nothing to show for it: either no client holds the card ("idle"
# from pick_temp) or a client holds it while utilization sits at 0%. Only a
# fault while runtime PM is armed - with control=on (AC) the card sits in D0
# by policy and 0% load is simply what an unused dGPU looks like.
idle_now=0
if rpm_enabled && [[ "$temp" == "idle" || "$load" == "0" ]]; then idle_now=1; fi
held=$(idle_held "$idle_now")
(( idle_now )) && maybe_alert "$held"

# No client at all, so no temperature was read - same zzz the module has always
# shown for an unused card. Only the tooltip distinguishes why it is still up:
# runtime PM armed means it is on its way down, control=on means AC policy is
# holding it there and it will not drop until you unplug.
if [[ "$temp" == "idle" ]]; then
  notify_state_change normal
  if rpm_enabled; then why="idle, powering down"; else why="idle, AC policy keeps it powered"; fi
  printf '{"text":"GPU: zzz","class":"normal","alt":"sleeping","tooltip":"%s (%s)"}\n' "$name" "$why"
  exit 0
fi

if   (( temp < 60 )); then cls="normal"
elif (( temp < 80 )); then cls="warning"
else                       cls="critical"
fi

# The temperature stays on the bar - a number already means "awake" the way
# zzz means "asleep", and replacing it with a word threw that away. Flag the
# anomaly with the class instead, so it reads as a normal block that has gone
# amber rather than a different kind of block.
alt="$cls"
if (( idle_now )) && (( held >= IDLE_SHOW )); then
  cls="warning"; alt="idle-on"
  name="$name - awake at 0% load for $(( held / 60 )) min, nothing is rendering on it"
fi

notify_state_change "$cls"
printf '{"text":"GPU: %d°C","class":"%s","alt":"%s","tooltip":"%s"}\n' "$temp" "$cls" "$alt" "$name"
